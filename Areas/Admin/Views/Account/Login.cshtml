@{
    ViewData["Title"] = "Đăng nhập Admin";
    Layout = null;
    var errorMessage = ViewBag.ErrorMessage as string;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: #f3f4f6;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .login-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            padding: 32px 28px;
        }

        .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 22px;
        }

        .brand-mark {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 700;
        }

        .brand-text {
            font-size: 1.05rem;
            font-weight: 700;
            color: #111827;
        }

        .brand-sub {
            font-size: 0.75rem;
            color: #6b7280;
        }

        .form-title {
            text-align: center;
            font-size: 1.7rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: #111827;
        }

        .form-subtitle {
            text-align: center;
            color: #6b7280;
            font-size: 0.92rem;
            margin-bottom: 24px;
        }

        .alert {
            margin-bottom: 18px;
            border-radius: 12px;
            border: 1px solid #fecaca;
            background: #fef2f2;
            color: #b91c1c;
            padding: 10px 12px;
            font-size: 0.9rem;
        }

        .form-control {
            border-radius: 12px;
            border: 1px solid #d1d5db;
            background: #fff;
            min-height: 52px;
            padding-left: 14px;
        }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.12);
        }

        .mb-3 {
            margin-bottom: 16px !important;
        }

        .btn-primary {
            width: 100%;
            min-height: 52px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-primary:hover {
            filter: brightness(0.98);
        }

        .btn-primary:disabled {
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-card">
            <div class="brand">
                <div class="brand-mark">
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                </div>
                <div>
                    <div class="brand-text">HTTT Admin</div>
                    <div class="brand-sub">Quản trị viên hệ thống</div>
                </div>
            </div>

            <h1 class="form-title">Đăng nhập Admin</h1>
            <p class="form-subtitle">Dành riêng cho Quản trị viên hệ thống (`Admin`)</p>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert" role="alert">@errorMessage</div>
            }

            <form asp-area="Admin" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" id="loginForm">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="username" class="form-label visually-hidden">Tên đăng nhập</label>
                    <input id="username" name="username" type="text" class="form-control" placeholder="Tên đăng nhập Quản trị viên" autocomplete="username" required autofocus />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label visually-hidden">Mật khẩu</label>
                    <input id="password" name="password" type="password" class="form-control" placeholder="Mật khẩu" autocomplete="current-password" required />
                </div>

                <button type="submit" class="btn btn-primary" id="btnLoginSubmit">
                    Đăng nhập Quản trị
                </button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const loginForm = document.getElementById('loginForm');
        const submitBtn = document.getElementById('btnLoginSubmit');

        if (loginForm && submitBtn) {
            loginForm.addEventListener('submit', function (event) {
                if (!event.target.checkValidity()) {
                    event.preventDefault();
                    event.target.reportValidity();
                    return;
                }

                submitBtn.disabled = true;
                submitBtn.textContent = 'Đang đăng nhập...';
            });
        }
    </script>
</body>
</html>
