@{
    ViewData["Title"] = "Đăng nhập Admin";
    Layout = null; /* Standalone page, no sidebar/header */
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — HTTT Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="/css/admin-style.css" rel="stylesheet" />
</head>
<body style="background: #0f172a; margin: 0; padding: 0;" data-error-message="@ViewBag.ErrorMessage">

<div class="adm-login-wrapper">

    <div class="adm-login-card">

        <!-- ── Left panel ── -->
        <div class="adm-login-panel-left">
            <!-- Brand -->
            <div class="adm-login-left-brand">
                <div class="adm-login-left-brand-icon">
                    <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                </div>
                <div>
                    <div class="adm-login-left-brand-name">HTTT Admin</div>
                    <div class="adm-login-left-brand-tagline">Hệ thống quản trị nội bộ</div>
                </div>
            </div>

            <!-- Hero illustration -->
            <div class="adm-login-left-hero">
                <i class="fa-solid fa-shield-halved adm-login-left-hero-icon" aria-hidden="true"></i>
                <h2 class="adm-login-left-headline">Trung tâm kiểm soát<br>toàn hệ thống</h2>
                <p class="adm-login-left-desc">
                    Quản trị tài khoản, phân quyền và giám sát hoạt động<br>
                    từ một bảng điều khiển tập trung, an toàn và hiệu quả.
                </p>
            </div>

            <!-- Feature list -->
            <ul class="adm-login-left-features" aria-label="Tính năng hệ thống">
                <li>
                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                    Quản lý tài khoản & phân quyền theo vai trò
                </li>
                <li>
                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                    Theo dõi hoạt động hệ thống theo thời gian thực
                </li>
                <li>
                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                    Bảo mật với Cookie Authentication ASP.NET Core
                </li>
            </ul>
        </div>

        <!-- ── Right panel (form) ── -->
        <div class="adm-login-panel-right">
            <h1 class="adm-login-form-title">Đăng nhập</h1>
            <p class="adm-login-form-subtitle">Vui lòng nhập thông tin tài khoản quản trị để tiếp tục.</p>

            <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" class="adm-login-form" novalidate>
                @Html.AntiForgeryToken()

                <!-- Username -->
                <div class="form-floating mb-3">
                    <input id="username" name="username" type="text" class="form-control"
                           placeholder="Tên đăng nhập" autocomplete="username"
                           required autofocus />
                    <label for="username">
                        <i class="fa-regular fa-user me-1" aria-hidden="true"></i>Tên đăng nhập
                    </label>
                </div>

                <!-- Password -->
                <div class="form-floating mb-4 position-relative">
                    <input id="password" name="password" type="password" class="form-control"
                           placeholder="Mật khẩu" autocomplete="current-password" required />
                    <label for="password">
                        <i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Mật khẩu
                    </label>
                    <button type="button" id="togglePwd"
                            class="btn btn-link position-absolute end-0 top-50 translate-middle-y me-1 text-muted border-0 bg-transparent p-2"
                            aria-label="Hiện / Ẩn mật khẩu" tabindex="-1">
                        <i class="fa-regular fa-eye" id="togglePwdIcon" aria-hidden="true"></i>
                    </button>
                </div>

                <button type="submit" class="adm-login-submit-btn">
                    <i class="fa-solid fa-arrow-right-to-bracket me-2" aria-hidden="true"></i>
                    Đăng nhập vào hệ thống
                </button>
            </form>

            <div class="adm-login-footer">
                <i class="fa-solid fa-lock fa-xs me-1" aria-hidden="true"></i>
                Phiên đăng nhập được mã hoá &amp; bảo vệ
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const toggleBtn = document.getElementById('togglePwd');
    const pwdInput = document.getElementById('password');
    const toggleIcon = document.getElementById('togglePwdIcon');

    if (toggleBtn && pwdInput && toggleIcon) {
        toggleBtn.addEventListener('click', function () {
            const isPassword = pwdInput.type === 'password';
            pwdInput.type = isPassword ? 'text' : 'password';
            toggleIcon.classList.toggle('fa-eye', !isPassword);
            toggleIcon.classList.toggle('fa-eye-slash', isPassword);
        });
    }
</script>
</body>
</html>
