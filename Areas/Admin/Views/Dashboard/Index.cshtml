@model httt.Areas.Admin.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-0">

    <!-- ── Page Header ── -->
    <div class="adm-page-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="adm-page-title" id="dashboardHeading">
                <i class="fa-solid fa-gauge-high me-2 text-primary" style="font-size: 1.125rem;" aria-hidden="true"></i>
                Dashboard Quản trị Tài khoản
            </h1>
            <p class="adm-page-subtitle">Thống kê tài khoản người dùng, phân quyền vai trò và trạng thái hoạt động hệ thống</p>
        </div>
        <span class="badge rounded-pill px-3 py-2" style="background: rgba(99,102,241,0.12); color: #4f46e5; font-size: 0.8rem; font-weight: 600;">
            <i class="fa-regular fa-clock me-1" aria-hidden="true"></i>
            <span id="liveTime">--:--</span>
        </span>
    </div>

    <!-- ── KPI Row: 4 Thẻ thống kê Tài khoản & Phân quyền (useraccount) ── -->
    @{
        var operationalStaffCount = Model.SalesCount + Model.WarehouseCount + Model.ProductionCount;
    }
    <div class="row g-4 mb-4">
        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card adm-kpi-card--primary h-100">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Tổng tài khoản</div>
                    <div class="adm-kpi-value">@Model.TotalAccounts</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-users fa-xs me-1" aria-hidden="true"></i>Toàn hệ thống</div>
                </div>
                <div class="adm-kpi-icon-wrap"><i class="fa-solid fa-users fa-xl" aria-hidden="true"></i></div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card adm-kpi-card--success h-100">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Đang hoạt động</div>
                    <div class="adm-kpi-value">@Model.ActiveAccounts</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-circle-check fa-xs me-1" aria-hidden="true"></i>Trạng thái Active</div>
                </div>
                <div class="adm-kpi-icon-wrap"><i class="fa-solid fa-user-check fa-xl" aria-hidden="true"></i></div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card adm-kpi-card--warning h-100">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Tài khoản bị khóa / ngưng</div>
                    <div class="adm-kpi-value">@Model.LockedAccounts</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-user-lock fa-xs me-1" aria-hidden="true"></i>Blocked / Disabled</div>
                </div>
                <div class="adm-kpi-icon-wrap"><i class="fa-solid fa-user-lock fa-xl" aria-hidden="true"></i></div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card adm-kpi-card--info h-100">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Nhân sự nghiệp vụ</div>
                    <div class="adm-kpi-value">@operationalStaffCount</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-id-badge fa-xs me-1" aria-hidden="true"></i>Bán hàng &bull; Kho &bull; Sản xuất</div>
                </div>
                <div class="adm-kpi-icon-wrap"><i class="fa-solid fa-user-gear fa-xl" aria-hidden="true"></i></div>
            </div>
        </div>
    </div>

    <!-- ── Phân bổ theo vai trò & Tài khoản mới tạo / cập nhật gần đây ── -->
    <div class="row g-4 mb-4">
        <!-- Doughnut chart: Phân bổ theo vai trò -->
        <div class="col-lg-5">
            <div class="adm-card h-100">
                <div class="adm-card-header">
                    <h2 class="adm-card-title">
                        <i class="fa-solid fa-chart-pie me-2 text-primary" style="font-size: 0.875rem;" aria-hidden="true"></i>
                        Phân bổ theo vai trò
                    </h2>
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(99,102,241,0.10); color: #4f46e5; font-size: 0.7rem;">Trực tiếp</span>
                </div>
                <div class="adm-card-body">
                    <div class="adm-chart-container" style="max-width: 300px;">
                        <canvas id="roleChart" aria-label="Biểu đồ tỷ lệ tài khoản theo vai trò" role="img"></canvas>
                    </div>
                    <!-- Legend summary (4 Vai trò chuẩn) -->
                    <div class="d-flex justify-content-center gap-4 mt-3 flex-wrap">
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #6366f1;">@Model.AdminCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Admin</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #10b981;">@Model.SalesCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Sales</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #8b5cf6;">@Model.WarehouseCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Warehouse</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #f59e0b;">@Model.ProductionCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Production</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Accounts Table -->
        <div class="col-lg-7">
            <div class="adm-card h-100">
                <div class="adm-card-header">
                    <h2 class="adm-card-title">
                        <i class="fa-solid fa-table-list me-2 text-primary" style="font-size: 0.875rem;" aria-hidden="true"></i>
                        Tài khoản mới tạo / cập nhật gần đây
                    </h2>
                    <a asp-area="Admin" asp-controller="UserAccount" asp-action="Index"
                       class="adm-btn adm-btn--outline adm-btn--sm">
                        <i class="fa-solid fa-arrow-right fa-xs" aria-hidden="true"></i>
                        Xem tất cả
                    </a>
                </div>
                <div class="adm-card-body--flush">
                    <div class="table-responsive" role="region" aria-label="Danh sách tài khoản gần đây" tabindex="0">
                        <table class="adm-table">
                            <caption class="visually-hidden">Tài khoản mới cập nhật cùng vai trò và trạng thái</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Tên đăng nhập</th>
                                    <th scope="col">Họ và tên</th>
                                    <th scope="col">Vai trò</th>
                                    <th scope="col">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentUsers.Any())
                                {
                                    @foreach (var item in Model.RecentUsers)
                                    {
                                        bool isActive = !string.Equals(item.Status, "Inactive", StringComparison.OrdinalIgnoreCase)
                                                     && !string.Equals(item.Status, "Blocked", StringComparison.OrdinalIgnoreCase)
                                                     && !string.Equals(item.Status, "Disabled", StringComparison.OrdinalIgnoreCase)
                                                     && item.Status != "false" && item.Status != "0";
                                        string roleBadge = item.Role switch
                                        {
                                            "Admin"      => "adm-badge--admin",
                                            "Production" => "adm-badge--production",
                                            "Warehouse"  => "adm-badge--warehouse",
                                            "Sales"      => "adm-badge--sales",
                                            _            => "adm-badge--production"
                                        };
                                        <tr>
                                            <td class="fw-semibold" style="color: #0f172a;">@item.Username</td>
                                            <td>@item.FullName</td>
                                            <td><span class="adm-badge @roleBadge">@item.Role</span></td>
                                            <td>
                                                <span class="adm-badge @(isActive ? "adm-badge--active" : "adm-badge--inactive")">
                                                    <i class="fa-solid @(isActive ? "fa-circle-check" : "fa-circle-xmark") fa-xs" aria-hidden="true"></i>
                                                    @(isActive ? "Hoạt động" : "Không hoạt động")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="fa-regular fa-circle-dot fa-2x mb-2 d-block opacity-25" aria-hidden="true"></i>
                                            Không có dữ liệu
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Sao lưu & Phục hồi Cơ sở dữ liệu ── -->
    <div class="adm-card mb-4">
        <div class="adm-card-header">
            <h2 class="adm-card-title">
                <i class="fa-solid fa-database me-2 text-primary" style="font-size: 0.875rem;" aria-hidden="true"></i>
                Sao lưu &amp; Phục hồi Cơ sở dữ liệu
            </h2>
            <span class="badge rounded-pill px-2 py-1" style="background: rgba(16,185,129,0.12); color: #059669; font-size: 0.7rem; font-weight: 600;">
                <i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i>An toàn dữ liệu
            </span>
        </div>
        <div class="adm-card-body">
            <div class="row g-4 align-items-center">
                <div class="col-lg-5">
                    <div class="p-3 rounded-3 border bg-light-subtle h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="fw-bold mb-1" style="color: #0f172a; font-size: 0.95rem;">
                                <i class="fa-solid fa-cloud-arrow-down me-1 text-primary" aria-hidden="true"></i>
                                Sao lưu dữ liệu hệ thống (.json)
                            </div>
                            <p class="text-muted mb-3" style="font-size: 0.825rem;">
                                Xuất toàn bộ dữ liệu hiện tại của cơ sở dữ liệu ra tập tin định dạng chuẩn JSON kèm dấu thời gian để lưu trữ dự phòng.
                            </p>
                        </div>
                        <div>
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="DownloadBackup"
                               class="adm-btn adm-btn--primary">
                                <i class="fa-solid fa-download me-1" aria-hidden="true"></i>
                                Tải bản Sao lưu (.json)
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="p-3 rounded-3 border bg-light-subtle h-100">
                        <div class="fw-bold mb-1" style="color: #0f172a; font-size: 0.95rem;">
                            <i class="fa-solid fa-cloud-arrow-up me-1 text-success" aria-hidden="true"></i>
                            Phục hồi CSDL từ bản sao lưu
                        </div>
                        <p class="text-muted mb-3" style="font-size: 0.825rem;">
                            Chọn tập tin sao lưu (<code>.json</code>) đã tải về trước đó để kiểm tra tính toàn vẹn và đồng bộ phục hồi dữ liệu an toàn.
                        </p>
                        <form asp-area="Admin" asp-controller="Dashboard" asp-action="RestoreBackup"
                              method="post" enctype="multipart/form-data"
                              class="d-flex flex-wrap align-items-center gap-2">
                            @Html.AntiForgeryToken()
                            <div class="flex-grow-1">
                                <input type="file" name="backupFile" accept=".json" class="form-control form-control-sm" required />
                            </div>
                            <button type="submit" class="adm-btn adm-btn--outline">
                                <i class="fa-solid fa-rotate-left me-1" aria-hidden="true"></i>
                                Phục hồi dữ liệu
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        (() => {
            /* ── Live clock ── */
            function updateClock() {
                const el = document.getElementById('liveTime');
                if (!el) return;
                el.textContent = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }
            updateClock();
            setInterval(updateClock, 1000);

            /* ── Doughnut Chart ── */
            const ctx = document.getElementById('roleChart');
            if (ctx) {
                const roleLabels = @Html.Raw(Model.RoleLabels);
                const roleValues = @Html.Raw(Model.RoleValues);

                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: roleLabels,
                        datasets: [{
                            data: roleValues,
                            backgroundColor: ['#6366f1','#10b981','#8b5cf6','#f59e0b'],
                            borderColor: Array(4).fill('#fff'),
                            borderWidth: 3,
                            hoverOffset: 10,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        cutout: '70%',
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    usePointStyle: true, pointStyle: 'circle',
                                    padding: 16,
                                    font: { size: 11, weight: '600' },
                                    color: '#64748b'
                                }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                padding: 12, cornerRadius: 8,
                                titleFont: { size: 12, weight: '700' },
                                bodyFont: { size: 13 },
                                callbacks: {
                                    label(context) {
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const pct = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                        return `  ${context.label}: ${context.parsed} (${pct}%)`;
                                    }
                                }
                            }
                        }
                    }
                });
            }
        })();
    </script>
}
