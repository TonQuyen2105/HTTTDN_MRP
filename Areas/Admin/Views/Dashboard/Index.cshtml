@model httt.Areas.Admin.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-0">

    <!-- ── Page Header ── -->
    <div class="adm-page-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="adm-page-title" id="dashboardHeading">
                <i class="fa-solid fa-gauge-high me-2 text-primary" style="font-size: 1.125rem;" aria-hidden="true"></i>
                Dashboard
            </h1>
            <p class="adm-page-subtitle">Tổng quan toàn hệ thống MRP Dược phẩm</p>
        </div>
        <span class="badge rounded-pill px-3 py-2" style="background: rgba(99,102,241,0.12); color: #4f46e5; font-size: 0.8rem; font-weight: 600;">
            <i class="fa-regular fa-clock me-1" aria-hidden="true"></i>
            <span id="liveTime">--:--</span>
        </span>
    </div>

    <!-- ── KPI Row 1: Accounts ── -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card adm-kpi-card--primary h-100">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Tổng tài khoản</div>
                    <div class="adm-kpi-value">@Model.TotalAccounts</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-users fa-xs me-1" aria-hidden="true"></i>Toàn hệ thống</div>
                </div>
                <div class="adm-kpi-icon-wrap text-primary"><i class="fa-solid fa-users fa-2x" aria-hidden="true"></i></div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card adm-kpi-card--success h-100">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Đang hoạt động</div>
                    <div class="adm-kpi-value">@Model.ActiveAccounts</div>
                <div class="adm-kpi-delta"><i class="fa-solid fa-circle-check fa-xs me-1" aria-hidden="true"></i>Hoạt động</div>
                </div>
                <div class="adm-kpi-icon-wrap text-success"><i class="fa-solid fa-user-check fa-2x" aria-hidden="true"></i></div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card adm-kpi-card--warning h-100">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Sản phẩm trong kho</div>
                    <div class="adm-kpi-value">@Model.TotalProducts</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-box fa-xs me-1" aria-hidden="true"></i>Thành phẩm</div>
                </div>
                <div class="adm-kpi-icon-wrap text-warning"><i class="fa-solid fa-boxes-stacked fa-2x" aria-hidden="true"></i></div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card adm-kpi-card--info h-100">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Nguyên liệu</div>
                    <div class="adm-kpi-value">@Model.TotalIngredients</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-flask fa-xs me-1" aria-hidden="true"></i>Chủng loại</div>
                </div>
                <div class="adm-kpi-icon-wrap text-info"><i class="fa-solid fa-flask fa-2x" aria-hidden="true"></i></div>
            </div>
        </div>
    </div>

    <!-- ── KPI Row 2: MRP + Sales ── -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card h-100" style="border-top: 3px solid #f59e0b;">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Lệnh SX chờ duyệt</div>
                    <div class="adm-kpi-value" style="color: #d97706;">@Model.PendingProductionRequests</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-clock fa-xs me-1" aria-hidden="true"></i>Pending</div>
                </div>
                <div class="adm-kpi-icon-wrap" style="color: #f59e0b;"><i class="fa-solid fa-industry fa-2x" aria-hidden="true"></i></div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card h-100" style="border-top: 3px solid #8b5cf6;">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Đơn hàng tháng này</div>
                    <div class="adm-kpi-value" style="color: #7c3aed;">@Model.MonthOrders</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-cart-shopping fa-xs me-1" aria-hidden="true"></i>Sale Orders</div>
                </div>
                <div class="adm-kpi-icon-wrap" style="color: #8b5cf6;"><i class="fa-solid fa-cart-shopping fa-2x" aria-hidden="true"></i></div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="adm-kpi-card h-100" style="border-top: 3px solid #ef4444;">
                <div class="adm-kpi-card-body">
                    <div class="adm-kpi-label">Đơn chờ xuất kho</div>
                    <div class="adm-kpi-value" style="color: #dc2626;">@Model.PendingApprovalOrders</div>
                    <div class="adm-kpi-delta"><i class="fa-solid fa-triangle-exclamation fa-xs me-1" aria-hidden="true"></i>Chưa duyệt</div>
                </div>
                <div class="adm-kpi-icon-wrap" style="color: #ef4444;"><i class="fa-solid fa-truck-ramp-box fa-2x" aria-hidden="true"></i></div>
            </div>
        </div>
    </div>

    <!-- ── Charts + Activity ── -->
    <div class="row g-4 mb-4">
        <!-- Doughnut chart -->
        <div class="col-lg-5">
            <div class="adm-card h-100">
                <div class="adm-card-header">
                    <h2 class="adm-card-title">
                        <i class="fa-solid fa-chart-pie me-2 text-primary" style="font-size: 0.875rem;" aria-hidden="true"></i>
                        Phân bổ theo vai trò
                    </h2>
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(99,102,241,0.10); color: #4f46e5; font-size: 0.7rem;">Trực tiếp</span>
                </div>
                <div class="adm-card-body">
                    <div class="adm-chart-container" style="max-width: 300px;">
                        <canvas id="roleChart" aria-label="Biểu đồ tỷ lệ tài khoản theo vai trò" role="img"></canvas>
                    </div>
                    <!-- Legend summary -->
                    <div class="d-flex justify-content-center gap-3 mt-3 flex-wrap">
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #6366f1;">@Model.AdminCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Admin</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #06b6d4;">@Model.ManagerCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Manager</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #64748b;">@Model.EmployeeCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Employee</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #f59e0b;">@Model.ProductionCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Production</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #8b5cf6;">@Model.WarehouseCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Warehouse</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-700 fs-5" style="color: #10b981;">@Model.SalesCount</div>
                            <div style="font-size: 0.7rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Sales</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Low-stock warnings -->
        <div class="col-lg-7">
            <div class="adm-card h-100">
                <div class="adm-card-header">
                    <h2 class="adm-card-title">
                        <i class="fa-solid fa-triangle-exclamation me-2 text-warning" style="font-size: 0.875rem;" aria-hidden="true"></i>
                        Cảnh báo tồn kho thấp
                    </h2>
                    <span class="adm-badge adm-badge--inactive">@Model.LowStockWarnings.Count mục</span>
                </div>
                <div class="adm-card-body--flush">
                    @if (Model.LowStockWarnings.Any())
                    {
                        <div class="table-responsive">
                            <table class="adm-table">
                                <thead>
                                    <tr>
                                        <th>Tên</th>
                                        <th>Loại</th>
                                        <th>Tồn kho</th>
                                        <th>Ngưỡng tối thiểu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LowStockWarnings.Take(8))
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.Name</td>
                                            <td>
                                                <span class="adm-badge @(item.Type == "product" ? "adm-badge--admin" : "adm-badge--manager")">
                                                    @(item.Type == "product" ? "Thành phẩm" : "Nguyên liệu")
                                                </span>
                                            </td>
                                            <td class="text-danger fw-bold">@item.Quantity.ToString("N0")</td>
                                            <td class="text-muted">@item.Threshold.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted text-center py-4" style="font-size: 0.95rem;">
                            <i class="fa-regular fa-circle-check me-2 text-success" aria-hidden="true"></i>Tồn kho đang ở mức an toàn
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── Recent Accounts Table ── -->
    <div class="adm-card">
        <div class="adm-card-header">
            <h2 class="adm-card-title">
                <i class="fa-solid fa-table-list me-2 text-primary" style="font-size: 0.875rem;" aria-hidden="true"></i>
                Tài khoản mới nhất
            </h2>
            <a asp-area="Admin" asp-controller="UserAccount" asp-action="Index"
               class="adm-btn adm-btn--outline adm-btn--sm">
                <i class="fa-solid fa-arrow-right fa-xs" aria-hidden="true"></i>
                Xem tất cả
            </a>
        </div>
        <div class="adm-card-body--flush">
            <div class="table-responsive" role="region" aria-label="Danh sách tài khoản gần đây" tabindex="0">
                <table class="adm-table">
                    <caption class="visually-hidden">Tài khoản mới cập nhật cùng vai trò và trạng thái</caption>
                    <thead>
                        <tr>
                            <th scope="col">Tên đăng nhập</th>
                            <th scope="col">Họ và tên</th>
                            <th scope="col">Vai trò</th>
                            <th scope="col">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentUsers.Any())
                        {
                            @foreach (var item in Model.RecentUsers)
                            {
                                bool isActive = !string.Equals(item.Status, "Inactive", StringComparison.OrdinalIgnoreCase)
                                             && item.Status != "false" && item.Status != "0";
                                string roleBadge = item.Role switch
                                {
                                    "Admin"      => "adm-badge--admin",
                                    "Manager"    => "adm-badge--manager",
                                    "Production" => "adm-badge--production",
                                    "Warehouse"  => "adm-badge--warehouse",
                                    "Sales"      => "adm-badge--sales",
                                    _            => "adm-badge--employee"
                                };
                                <tr>
                                    <td class="fw-semibold" style="color: #0f172a;">@item.Username</td>
                                    <td>@item.FullName</td>
                                    <td><span class="adm-badge @roleBadge">@item.Role</span></td>
                                    <td>
                                        <span class="adm-badge @(isActive ? "adm-badge--active" : "adm-badge--inactive")">
                                            <i class="fa-solid @(isActive ? "fa-circle-check" : "fa-circle-xmark") fa-xs" aria-hidden="true"></i>
                                            @(isActive ? "Hoạt động" : "Không hoạt động")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="fa-regular fa-circle-dot fa-2x mb-2 d-block opacity-25" aria-hidden="true"></i>
                                    Không có dữ liệu
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        (() => {
            /* ── Live clock ── */
            function updateClock() {
                const el = document.getElementById('liveTime');
                if (!el) return;
                el.textContent = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }
            updateClock();
            setInterval(updateClock, 1000);

            /* ── Doughnut Chart ── */
            const ctx = document.getElementById('roleChart');
            if (ctx) {
                const roleLabels = @Html.Raw(Model.RoleLabels);
                const roleValues = @Html.Raw(Model.RoleValues);

                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: roleLabels,
                        datasets: [{
                            data: roleValues,
                            backgroundColor: ['#6366f1','#06b6d4','#94a3b8','#f59e0b','#8b5cf6','#10b981'],
                            borderColor: Array(6).fill('#fff'),
                            borderWidth: 3,
                            hoverOffset: 10,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        cutout: '70%',
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    usePointStyle: true, pointStyle: 'circle',
                                    padding: 16,
                                    font: { size: 11, weight: '600' },
                                    color: '#64748b'
                                }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                padding: 12, cornerRadius: 8,
                                titleFont: { size: 12, weight: '700' },
                                bodyFont: { size: 13 },
                                callbacks: {
                                    label(context) {
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const pct = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                        return `  ${context.label}: ${context.parsed} (${pct}%)`;
                                    }
                                }
                            }
                        }
                    }
                });
            }
        })();
    </script>
}
