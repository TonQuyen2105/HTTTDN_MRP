<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HTTT Admin</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.min.css" rel="stylesheet" />
    <!-- Admin CSS -->
    <link href="/css/admin-style.css" rel="stylesheet" />
</head>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString();
    var successMessage    = TempData["SuccessMessage"] as string;
    var errorMessage      = TempData["ErrorMessage"] as string;

    /* ── Breadcrumb data per page ── */
    string bcSection = currentController switch {
        "Dashboard"   => "Dashboard",
        "UserAccount" => "Quản lý Tài khoản",
        _             => ViewData["Title"]?.ToString() ?? ""
    };
    bool isHome = currentController == "Dashboard" && currentAction == "Index";
}
<body class="admin-layout" data-success-message="@successMessage" data-error-message="@errorMessage">

<div class="d-flex min-vh-100">

    <!-- ════════════ SIDEBAR (desktop) ════════════ -->
    <aside class="adm-sidebar d-none d-lg-flex">
        <a class="adm-sidebar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <span class="adm-sidebar-brand-icon">
                <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
            </span>
            <span>
                <div class="adm-sidebar-brand-text">HTTT Admin</div>
                <div class="adm-sidebar-brand-sub">Bảng điều khiển</div>
            </span>
        </a>

        <partial name="_SidebarNav" />

        <div class="adm-sidebar-footer">
            <p class="adm-sidebar-footer-text">Phiên bản 2.0 &bull; Quản trị viên hệ thống</p>
        </div>
    </aside>

    <!-- ════════════ SIDEBAR (mobile offcanvas) ════════════ -->
    <div class="offcanvas adm-offcanvas offcanvas-start d-lg-none" tabindex="-1" id="adminSidebar">
        <div class="offcanvas-header" style="border-bottom: 1px solid rgba(255,255,255,0.08); padding: 1.25rem;">
            <div class="d-flex align-items-center gap-2">
                <span class="adm-sidebar-brand-icon">
                    <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                </span>
                <div>
                    <div class="adm-sidebar-brand-text">HTTT Admin</div>
                    <div class="adm-sidebar-brand-sub">Bảng điều khiển</div>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body p-0">
            <partial name="_SidebarNav" />
        </div>
    </div>

    <!-- ════════════ CONTENT AREA ════════════ -->
    <div class="flex-grow-1 d-flex flex-column" style="min-width: 0; overflow-x: hidden;">

        <!-- ── Header ── -->
        <header class="adm-header">
            <!-- Mobile toggle -->
            <button class="adm-header-toggle" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#adminSidebar"
                    aria-controls="adminSidebar" aria-label="Mở menu">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="flex-grow-1 min-w-0">
                <ol class="adm-breadcrumb">
                    <li class="adm-breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="fa-solid fa-house-chimney me-1" aria-hidden="true"></i>Admin
                        </a>
                    </li>
                    @if (!isHome)
                    {
                        <li class="adm-breadcrumb-item">
                            <i class="fa-solid fa-angle-right adm-breadcrumb-separator" aria-hidden="true"></i>
                        </li>
                        <li class="adm-breadcrumb-item active" aria-current="page">@bcSection</li>
                    }
                    else
                    {
                        <li class="adm-breadcrumb-item">
                            <i class="fa-solid fa-angle-right adm-breadcrumb-separator" aria-hidden="true"></i>
                        </li>
                        <li class="adm-breadcrumb-item active" aria-current="page">Dashboard</li>
                    }
                </ol>
            </nav>

            <!-- User Dropdown -->
            <div class="dropdown">
                <button class="adm-user-btn" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu người dùng">
                    <span class="adm-user-avatar" aria-hidden="true">A</span>
                    <span class="adm-user-info d-none d-sm-flex">
                        <span class="adm-user-name">Admin</span>
                        <span class="adm-user-role">Quản trị viên</span>
                    </span>
                    <i class="fa-solid fa-chevron-down ms-1 d-none d-sm-inline" style="font-size: 0.625rem; color: #94a3b8;" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu adm-dropdown-menu dropdown-menu-end" role="menu">
                    <li>
                        <div class="adm-dropdown-header">
                            <div class="adm-dropdown-header-name">
                                @if (User?.Identity?.IsAuthenticated == true)
                                {
                                    @User.Identity.Name
                                }
                                else
                                {
                                    <text>Admin</text>
                                }
                            </div>
                            <div class="adm-dropdown-header-role">Quản trị viên hệ thống</div>
                        </div>
                    </li>
                    <li>
                        <a class="adm-dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" role="menuitem">
                            <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a class="adm-dropdown-item" asp-area="Admin" asp-controller="Account" asp-action="Profile" role="menuitem">
                            <i class="fa-solid fa-user-circle" aria-hidden="true"></i>
                            <span>Hồ sơ của tôi</span>
                        </a>
                    </li>
                    <li><hr class="adm-dropdown-divider" /></li>
                    <li>
                        <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="adm-dropdown-item text-danger" role="menuitem">
                                <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                                <span>Đăng xuất</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <!-- ── Page Content ── -->
        <main class="adm-main">
            @RenderBody()
        </main>

    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const successMessage = document.body.dataset.successMessage?.trim();
        const errorMessage = document.body.dataset.errorMessage?.trim();

        function showAdminToast(icon, text) {
            if (!text) return;
            Swal.fire({
                icon,
                title: text,
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                customClass: { popup: 'adm-swal-toast' },
                didOpen: function (toastElement) {
                    toastElement.addEventListener('mouseenter', Swal.stopTimer);
                    toastElement.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
        }

        if (successMessage) {
            showAdminToast('success', successMessage);
        }

        if (errorMessage) {
            showAdminToast('error', errorMessage);
        }

        document.querySelectorAll('form').forEach(function (form) {
            if (form.dataset.adminSubmitBound === 'true' || form.dataset.ajaxForm === 'true' || form.hasAttribute('novalidate')) {
                return;
            }

            form.dataset.adminSubmitBound = 'true';
            form.addEventListener('submit', function (event) {
                if (event.defaultPrevented || form.dataset.ajaxForm === 'true' || !form.checkValidity()) {
                    return;
                }

                const submitButton = form.querySelector('button[type="submit"], input[type="submit"]');
                if (!submitButton) {
                    return;
                }

                if (submitButton.dataset.adminLoadingBound === 'true') {
                    return;
                }

                if (form.dataset.adminSubmitting === 'true') {
                    event.preventDefault();
                    return;
                }

                form.dataset.adminSubmitting = 'true';
                submitButton.dataset.adminLoadingBound = 'true';
                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Đang xử lý...';
            });
        });
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
