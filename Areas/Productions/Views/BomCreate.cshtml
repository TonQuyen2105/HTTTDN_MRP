    <!-- NỘI DUNG CHÍNH (THÊM BOM) -->
    <main class="app-main">
      <div class="main-container page-fade-in">

        <div class="bom-form-card">
          <div class="bom-form-header">
            <h1 class="bom-form-title">Thêm Định mức nguyên vật liệu (BOM)</h1>
            <div class="order-header-actions">
              <button type="button" class="btn-header-tool" title="Trợ giúp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </button>
              <button type="button" class="btn-header-tool" id="btnCloseBom" title="Đóng">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>

          <div class="bom-form-body">
            
            <!-- 1. THÔNG TIN CHUNG -->
            <div class="bom-section-box">
              <h2 class="bom-section-title">Thông tin chung</h2>

              <div class="bom-form-row">
                <div class="bom-field" style="flex: 2;">
                  <label class="bom-field-label">Sản phẩm thuốc <span class="required-mark">*</span></label>
                  <select class="form-select">
                    @if (ViewBag.Products != null && ((IEnumerable<httt.Models.Product>)ViewBag.Products).Any())
                    {
                        foreach (var prod in (IEnumerable<httt.Models.Product>)ViewBag.Products)
                        {
                            <option value="@prod.ProductId">@prod.ProductName (@prod.Unit)</option>
                        }
                    }
                    else
                    {
                        <option selected>Ginkgo Biloba 120mg Trunature (Hộp 6 vỉ x 10 viên)</option>
                        <option>Glucosamine HCL 1500mg (Chai 180 viên nén)</option>
                        <option>Milk Thistle Extract 1000mg (Hộp 60 viên)</option>
                        <option>Viên nén Paracetamol 500mg (Hộp 10 vỉ x 10 viên)</option>
                        <option>Amoxicillin Trihydrate 500mg (Hộp 10 vỉ x 10 viên)</option>
                    }
                  </select>
                </div>

                <div class="bom-field" style="flex: 1;">
                  <span class="bom-field-label" style="min-width: 60px;">Loại BOM</span>
                  <div class="radio-group-wrap">
                    <label class="radio-item">
                      <input type="radio" name="bomType" value="production" checked>
                      BOM sản xuất GMP
                    </label>
                    <label class="radio-item">
                      <input type="radio" name="bomType" value="trial">
                      BOM thử nghiệm lâm sàng
                    </label>
                  </div>
                </div>
              </div>

              <div class="bom-form-row">
                <div class="bom-field" style="flex: 1;">
                  <label class="bom-field-label">Mã BOM <span class="required-mark">*</span></label>
                  <input type="text" class="form-input" value="BOM-GINKGO120-API">
                </div>

                <div class="bom-field" style="flex: 2;">
                  <label class="bom-field-label">Tên BOM <span class="required-mark">*</span></label>
                  <input type="text" class="form-input" value="Định mức nguyên vật liệu sản xuất Ginkgo Biloba 120mg Trunature">
                </div>
              </div>

              <div class="bom-form-row">
                <div class="bom-field">
                  <label class="bom-field-label">
                    ĐVT 
                    <span class="info-tooltip-icon">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                      </svg>
                    </span>
                  </label>
                  <select class="form-select">
                    <option selected>Hộp</option>
                    <option>Chai</option>
                    <option>Vỉ</option>
                  </select>
                </div>

                <div class="bom-field">
                  <label class="bom-field-label">Số lượng</label>
                  <input type="text" class="form-input text-right" value="1.000,0000">
                </div>

                <div class="bom-field">
                  <label class="bom-field-label">Phiên bản</label>
                  <input type="text" class="form-input" value="Ver 2">
                </div>

                <div class="bom-field">
                  <label class="bom-field-label">Hiệu lực</label>
                  <div class="form-control-wrap">
                    <input type="text" class="form-input has-calendar" value="15/01/2026">
                    <span class="calendar-icon-btn">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <div class="bom-form-row">
                <div class="bom-field" style="width: 100%;">
                  <label class="bom-field-label">Diễn giải</label>
                  <textarea class="form-textarea" placeholder="Nhập diễn giải cho định mức BOM..."></textarea>
                </div>
              </div>

              <div class="bom-form-row" style="margin-top: 8px;">
                <div class="bom-field">
                  <span class="bom-field-label">Trạng thái</span>
                  <div class="radio-group-wrap">
                    <label class="radio-item">
                      <input type="radio" name="bomStatus" value="active" checked>
                      Đang sử dụng
                    </label>
                    <label class="radio-item">
                      <input type="radio" name="bomStatus" value="inactive">
                      Ngừng sử dụng
                    </label>
                  </div>
                </div>
              </div>

            </div>

            <!-- 2. DANH SÁCH NGUYÊN VẬT LIỆU (ĐÃ LOẠI BỎ KHUNG XANH) -->
            <div class="bom-section-box">
              <h2 class="bom-section-title">Danh sách nguyên vật liệu</h2>

              <div class="table-responsive">
                <table class="bom-table">
                  <thead>
                    <tr>
                      <th class="text-center" style="width: 45px;">STT</th>
                      <th>Mã nguyên vật liệu ⬍</th>
                      <th>Tên nguyên vật liệu</th>
                      <th>Tính chất</th>
                      <th>ĐVT</th>
                      <th class="text-center">Là NVL chính</th>
                      <th class="text-right">Số lượng</th>
                      <th>Loại hao hụt</th>
                      <th class="text-right">Số hao hụt cố định</th>
                      <th class="text-right">Tỷ lệ hao hụt (%)</th>
                      <th class="text-center" style="width: 60px;">Thao tác</th>
                    </tr>
                  </thead>
                  <tbody id="bomMaterialsBody">
                    <tr>
                      <td class="text-center col-stt">1</td>
                      <td><strong>INGR0002</strong></td>
                      <td>Cao khô Ginkgo Biloba chuẩn hóa API</td>
                      <td>Hoạt chất chính</td>
                      <td>kg</td>
                      <td class="text-center"><input type="checkbox" checked></td>
                      <td class="text-right">60,0000</td>
                      <td>Tỷ lệ cố định</td>
                      <td class="text-right">0,0000</td>
                      <td class="text-right">0,50</td>
                      <td class="text-center">
                        <button type="button" class="row-act-btn btn-delete-row" title="Xóa">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </td>
                    </tr>

                    <tr>
                      <td class="text-center col-stt">2</td>
                      <td><strong>INGR0006</strong></td>
                      <td>Tá dược Microcrystalline Cellulose (Avicel)</td>
                      <td>Tá dược độn</td>
                      <td>kg</td>
                      <td class="text-center"><input type="checkbox"></td>
                      <td class="text-right">40,0000</td>
                      <td>Tỷ lệ cố định</td>
                      <td class="text-right">0,0000</td>
                      <td class="text-right">0,20</td>
                      <td class="text-center">
                        <button type="button" class="row-act-btn btn-delete-row" title="Xóa">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </td>
                    </tr>

                    <tr>
                      <td class="text-center col-stt">3</td>
                      <td><strong>INGR0007</strong></td>
                      <td>Magnesi stearat GMP Dược dụng</td>
                      <td>Tá dược trơn</td>
                      <td>kg</td>
                      <td class="text-center"><input type="checkbox"></td>
                      <td class="text-right">2,5000</td>
                      <td>Tỷ lệ cố định</td>
                      <td class="text-right">0,0000</td>
                      <td class="text-right">0,10</td>
                      <td class="text-center">
                        <button type="button" class="row-act-btn btn-delete-row" title="Xóa">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      </td>
                    </tr>

                    <tr>
                      <td class="text-center col-stt">4</td>
                      <td><strong>INGR0008</strong></td>
                      <td>Povidone K30 (PVP K30)</td>
                      <td>Tá dược dính</td>
                      <td>kg</td>
                      <td class="text-center"><input type="checkbox"></td>
                      <td class="text-right">3,0000</td>
                      <td>Tỷ lệ cố định</td>
                      <td class="text-right">0,0000</td>
