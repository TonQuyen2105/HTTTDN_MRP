@model httt.Models.Bom?
@{
    Layout = null;
    var isNotFound = Model == null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AMIS Sản xuất - Sửa Định mức nguyên vật liệu (BOM)</title>
  
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/productions/production-order.css">
  <link rel="stylesheet" href="/css/productions/bom.css">
</head>
<body>
  <div class="app-wrapper">
    
    <!-- TOP HEADER -->
    <header class="app-header">
      <div class="header-left">
        <button type="button" class="btn-sidebar-toggle" id="sidebarToggleBtn" title="Đóng/Mở menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <a href="/Productions/Home/Index" class="app-brand" style="text-decoration: none; color: inherit;">
          <div class="app-brand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 20h20"></path>
              <path d="M5 20V8l5 4V8l5 4V4h4v16"></path>
            </svg>
          </div>
          <span class="app-brand-name">Sản xuất Dược</span>
        </a>
      </div>

      <div class="header-right">
        <div class="branch-selector" title="Chọn chi nhánh làm việc">
          <span>Chi nhánh:</span>
          <strong>Nhà máy Dược phẩm GMP Nam Hà</strong>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>

        <div class="header-actions">
          <button type="button" class="icon-btn" title="Cài đặt hệ thống">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </button>

          <button type="button" class="icon-btn" title="Trợ giúp & Hướng dẫn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </button>

          <button type="button" class="icon-btn" title="Thông báo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="badge-dot"></span>
          </button>
        </div>

        <a href="/Productions/Home/UserProfile" class="user-profile" title="Xem thông tin cá nhân" style="text-decoration:none;">
          @if (User.Identity?.IsAuthenticated == true)
          {
            <div class="user-avatar">@(User.Identity.Name?.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "ND")</div>
            <span class="user-name">@User.Identity.Name</span>
          }
          else
          {
            <div class="user-avatar" style="background: #64748b;">—</div>
            <span class="user-name" style="color: #64748b;">Chưa đăng nhập</span>
          }
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
      </div>
    </header>

            <!-- SIDEBAR -->
    <aside class="app-sidebar" id="appSidebar">
      <div class="sidebar-nav-container">
        
        <div class="nav-item">
          <a href="/Productions/Home/Index" class="nav-link ">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a10 10 0 0 1 10 10H12V2z"></path>
              </svg>
            </span>
            <span class="nav-text">Tổng quan</span>
          </a>
        </div>

        <div class="nav-item">
          <a href="/Productions/Home/DrugOrder" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </span>
            <span class="nav-text">Đơn đặt hàng thuốc</span>
          </a>
        </div>

        <div class="nav-item has-sub open">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </span>
            <span class="nav-text">Kế hoạch sản xuất</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <a href="/Productions/Home/MaterialRequirement" class="sub-link">Tính nhu cầu nguyên vật liệu</a>
          </div>
        </div>

        <!-- Điều phối & thực thi (Đã xóa Lịch sản xuất, Tình hình giao hàng) -->
        <div class="nav-item has-sub open">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </span>
            <span class="nav-text">Điều phối & thực thi</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <!-- <a href="/Productions/Home/ProductionOrder" class="sub-link ">Lệnh sản xuất thuốc</a> -->
            <a href="/Productions/Home/MaterialRequisitionList" class="sub-link ">Xuất kho hoạt chất</a>
            <a href="/Productions/Home/ProductionStatisticsList" class="sub-link ">Thống kê sản xuất</a>
            <!-- <a href="/Productions/Home/FinishedGoodsReceiptList" class="sub-link ">Nhập kho thành phẩm</a> -->
            <a href="/Productions/Home/HandoverList" class="sub-link ">Bàn giao thành phẩm</a>
          </div>
        </div>

        <div class="nav-section-title">QUẢN TRỊ & BÁO CÁO</div>

        <div class="nav-item has-sub">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </span>
            <span class="nav-text">Báo cáo</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <a href="#" class="sub-link">Báo cáo tiến độ lô SX</a>
            <a href="#" class="sub-link">Báo cáo hao hụt hoạt chất</a>
          </div>
        </div>

        <div class="nav-item">
          <a href="/Productions/Home/BomList" class="nav-link active">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </span>
            <span class="nav-text">Định mức công thức (BOM)</span>
          </a>
        </div>

      </div>

      <div class="sidebar-footer">
        <button type="button" class="btn-collapse-sidebar" id="sidebarCollapseBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="11 17 6 12 11 7"></polyline>
            <polyline points="18 17 13 12 18 7"></polyline>
          </svg>
          <span class="collapse-text">Thu gọn menu</span>
        </button>
      </div>
    </aside>

    <!-- NỘI DUNG CHÍNH (SỬA BOM) -->
    <main class="app-main">
      <div class="main-container page-fade-in">

        @if (isNotFound)
        {
          <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 24px; margin-bottom: 24px; color: #991b1b;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                <line x1="12" y1="12" x2="12" y2="16"></line>
              </svg>
              <h2 style="margin: 0; font-size: 18px; font-weight: 600;">Không tìm thấy Định mức BOM</h2>
            </div>
            <p style="margin: 0 0 16px 0; font-size: 14px; color: #7f1d1d;">Bản ghi định mức BOM không tồn tại hoặc đã bị xóa khỏi cơ sở dữ liệu. Vui lòng quay lại danh sách để chọn bản ghi hợp lệ.</p>
            <a href="/Productions/Home/BomList" class="btn-cancel" style="display: inline-block; text-decoration: none; padding: 8px 16px; background: #fff; border: 1px solid #cbd5e1; border-radius: 4px; color: #1e293b; font-weight: 500;">&larr; Về danh sách định mức</a>
          </div>
        }
        else
        {
        <div class="bom-form-card">
          <div class="bom-form-header">
            <h1 class="bom-form-title">Sửa Định mức nguyên vật liệu (BOM) #@Model?.BomId</h1>
            <div class="order-header-actions">
              <button type="button" class="btn-header-tool" title="Trợ giúp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </button>
              <button type="button" class="btn-header-tool" id="btnCloseBom" title="Đóng">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>

          <div class="bom-form-body">
            
            <!-- 1. THÔNG TIN CHUNG (VER 1 ĐANG SỬA) -->
            <div class="bom-section-box">
              <h2 class="bom-section-title">Thông tin chung</h2>

              <div class="bom-form-row">
                <div class="bom-field" style="flex: 2;">
                  <label class="bom-field-label">Sản phẩm thuốc <span class="required-mark">*</span></label>
                  <select class="form-select" disabled>
                    @if (Model?.Product != null)
                    {
                      <option selected>@Model.Product.ProductName (@Model.Product.Unit)</option>
                    }
                    else if (ViewBag.Products != null && ((IEnumerable<httt.Models.Product>)ViewBag.Products).Any())
                    {
                      foreach (var prod in (IEnumerable<httt.Models.Product>)ViewBag.Products)
                      {
                        <option value="@prod.ProductId" selected="@(prod.ProductId == Model?.ProductId ? "selected" : null)">@prod.ProductName (@prod.Unit)</option>
                      }
                    }
                    else
                    {
                      <option selected>— Chưa chọn sản phẩm —</option>
                    }
                  </select>
                </div>

                <div class="bom-field" style="flex: 1;">
                  <span class="bom-field-label" style="min-width: 60px;">Loại BOM</span>
                  <div class="radio-group-wrap">
                    <label class="radio-item">
                      <input type="radio" name="bomType" value="production" checked>
                      BOM sản xuất GMP
                    </label>
                  </div>
                </div>
              </div>

              <div class="bom-form-row">
                <div class="bom-field" style="flex: 1;">
                  <label class="bom-field-label">Mã BOM <span class="required-mark">*</span></label>
                  <input type="text" class="form-input" value="@(Model?.BomCode ?? (Model != null ? $"BOM-{Model.BomId:D4}" : "—"))" readonly>
                </div>

                <div class="bom-field" style="flex: 2;">
                  <label class="bom-field-label">Tên BOM <span class="required-mark">*</span></label>
                  <input type="text" class="form-input" value="@(Model?.BomName ?? (Model?.Product != null ? $"Định mức cho {Model.Product.ProductName}" : "—"))">
                </div>
              </div>

              <div class="bom-form-row">
                <div class="bom-field">
                  <label class="bom-field-label">ĐVT</label>
                  <input type="text" class="form-input" value="@(Model?.Product?.Unit ?? "Hộp")" readonly>
                </div>

                <div class="bom-field">
                  <label class="bom-field-label">Số lượng</label>
                  <input type="text" class="form-input text-right" value="@(Model != null ? Model.ItemQuantity.ToString("N0") : "1")">
                </div>

                <div class="bom-field">
                  <label class="bom-field-label">Phiên bản</label>
                  <input type="text" class="form-input" value="—" readonly placeholder="Chưa cập nhật">
                </div>

                <div class="bom-field">
                  <label class="bom-field-label">Hiệu lực</label>
                  <div class="form-control-wrap">
                    <input type="text" class="form-input" value="—" readonly placeholder="Chưa cập nhật">
                  </div>
                </div>
              </div>

              <div class="bom-form-row">
                <div class="bom-field" style="width: 100%;">
                  <label class="bom-field-label">Diễn giải</label>
                  <textarea class="form-textarea" placeholder="Nhập diễn giải định mức (nếu có)">@(Model?.BomName ?? "")</textarea>
                </div>
              </div>

              <div class="bom-form-row" style="margin-top: 8px;">
                <div class="bom-field">
                  <span class="bom-field-label">Trạng thái</span>
                  <div class="radio-group-wrap">
                    <label class="radio-item">
                      <input type="radio" name="bomStatusEdit" value="active" checked>
                      Đang áp dụng
                    </label>
                  </div>
                </div>
              </div>

            </div>

            <!-- 2. DANH SÁCH NGUYÊN VẬT LIỆU (ĐÃ LOẠI BỎ KHUNG XANH) -->
            <div class="bom-section-box">
              <h2 class="bom-section-title">Danh sách nguyên vật liệu</h2>

              <div class="table-responsive">
                <table class="bom-table">
                  <thead>
                    <tr>
                      <th class="text-center" style="width: 45px;">STT</th>
                      <th>Mã nguyên vật liệu ⬍</th>
                      <th>Tên nguyên vật liệu</th>
                      <th>Tính chất</th>
                      <th>ĐVT</th>
                      <th class="text-center">Là NVL chính</th>
                      <th class="text-right">Số lượng</th>
                      <th>Loại hao hụt</th>
                      <th class="text-right">Số hao hụt cố định</th>
                      <th class="text-right">Tỷ lệ hao hụt (%)</th>
                      <th class="text-center" style="width: 60px;">Thao tác</th>
                    </tr>
                  </thead>
                  <tbody id="bomMaterialsBody">
                    @if (Model?.Ingredient != null)
                    {
                      <tr>
                        <td class="text-center col-stt">1</td>
                        <td><strong>INGR@(Model.IngrId.ToString("D4"))</strong></td>
                        <td>@(Model.Ingredient.IngrName ?? "—")</td>
                        <td>Hoạt chất chính</td>
                        <td>@(Model.Ingredient.Unit ?? "kg")</td>
                        <td class="text-center"><input type="checkbox" checked disabled></td>
                        <td class="text-right">@Model.MaterialQuantity.ToString("0.####")</td>
                        <td>Tỷ lệ cố định</td>
                        <td class="text-right">—</td>
                        <td class="text-right">—</td>
                        <td class="text-center">
                          <button type="button" class="row-act-btn btn-delete-row" title="Xóa" disabled style="opacity: 0.5; cursor: not-allowed;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <polyline points="3 6 5 6 21 6"></polyline>
                              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                          </button>
                        </td>
                      </tr>
                    }
                    else
                    {
                      <tr>
                        <td colspan="11" style="text-align: center; color: #64748b; font-style: italic; padding: 24px;">Chưa có dữ liệu nguyên vật liệu cho BOM này</td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>

              <div class="table-footer-bar">
                <div class="table-footer-left">
                  <span>Tổng số: <strong id="totalMaterialsCount">@(Model?.Ingredient != null ? 1 : 0)</strong></span>
                  <button type="button" class="btn-table-action btn-add-row" id="btnAddMaterialRow">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Thêm dòng
                  </button>
                  <button type="button" class="btn-table-action btn-clear-rows" id="btnClearMaterialRows">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    Xóa hết dòng
                  </button>
                </div>
              </div>

              <!-- ĐÃ LOẠI BỎ CON DẤU MỘC THEO YÊU CẦU -->
            </div>

            <!-- 3. PHỤ PHẨM -->
            <div class="bom-section-box">
              <h2 class="bom-section-title">Phụ phẩm</h2>

              <div class="table-responsive">
                <table class="bom-table">
                  <thead>
                    <tr>
                      <th class="text-center" style="width: 45px;">STT</th>
                      <th>Phụ phẩm</th>
                      <th>Tên phụ phẩm</th>
                      <th>ĐVT</th>
                      <th class="text-right">Số lượng</th>
                      <th>Công đoạn phát sinh</th>
                      <th class="text-center" style="width: 60px;">Thao tác</th>
                    </tr>
                  </thead>
                  <tbody id="byProductsBody">
                    <tr>
                      <td colspan="7" style="text-align: center; color: #64748b; font-style: italic; padding: 20px;">
                        Chưa có dữ liệu phụ phẩm ghi nhận cho định mức này
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <div class="table-footer-bar">
                <div class="table-footer-left">
                  <button type="button" class="btn-table-action btn-add-row" id="btnAddByProductRow">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="12" y1="5" x2="12" y2="19"></line>
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Thêm dòng
                  </button>
                  <button type="button" class="btn-table-action btn-clear-rows" id="btnClearByProductRows">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    Xóa hết dòng
                  </button>
                </div>
              </div>
            </div>

            <!-- 4. TỆP ĐÍNH KÈM -->
            <div class="bom-section-box">
              <h2 class="bom-section-title">Tệp đính kèm</h2>

              <div class="file-dropzone-area">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.8">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <div>
                  <span class="dropzone-link">Chọn tệp</span> hoặc kéo và thả tệp vào đây
                </div>
                <div class="dropzone-sub">Hỗ trợ các định dạng: .pdf, .xlsx, .docx, .png, .jpg (Tối đa 25MB)</div>
              </div>
            </div>

          </div>

        </div>

        <div style="margin-top: 16px; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 6px; padding: 12px 16px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: #92400e;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span><strong>Lưu ý:</strong> Chức năng cập nhật Định mức BOM hiện chưa được kết nối API backend lưu vào CSDL. Dữ liệu thay đổi trên form sẽ không được lưu vĩnh viễn.</span>
        </div>

        <div class="bom-action-footer">
          <button type="button" class="btn-cancel" id="btnCancelBom">Hủy</button>
          <button type="button" class="btn-save-draft" disabled title="Chức năng chưa triển khai" style="opacity: 0.6; cursor: not-allowed;">Lưu và thêm mới</button>
          <button type="button" class="btn-save-submit" id="btnSaveBom">Cập nhật định mức</button>
        </div>
        }

      </div>
    </main>

  </div>

  <script src="/js/app.js"></script>
  <script src="/js/productions/bom.js"></script>
</body>
</html>
