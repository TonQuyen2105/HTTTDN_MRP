@model List<httt.Models.BomFormulaViewModel>
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  
  <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/productions/production-order.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/productions/bom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/productions/bom-editor.css" asp-append-version="true" />
</head>
<body>
  <div class="app-wrapper">
    <header class="app-header">
      <div class="header-left">
        <button type="button" class="btn-sidebar-toggle" id="sidebarToggleBtn" title="Đóng/Mở menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <a href="/Productions/Home/Index" class="app-brand" style="text-decoration: none; color: inherit;">
          <div class="app-brand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 20h20"></path>
              <path d="M5 20V8l5 4V8l5 4V4h4v16"></path>
            </svg>
          </div>
          <span class="app-brand-name">Sản xuất Dược</span>
        </a>
      </div>
      <div class="header-right">
        <div class="branch-selector" title="Chọn chi nhánh làm việc">
          <span>Chi nhánh:</span>
          <strong>Nhà máy Dược phẩm GMP Nam Hà</strong>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
        <div class="header-actions">
          <button type="button" class="icon-btn" title="Cài đặt hệ thống"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></button>
          <button type="button" class="icon-btn" title="Trợ giúp & Hướng dẫn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></button>
          <button type="button" class="icon-btn" title="Thông báo"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg><span class="badge-dot"></span></button>
        </div>
        <a href="/Productions/Home/UserProfile" class="user-profile" style="text-decoration: none; color: inherit;" title="Tài khoản cá nhân">
          @if (User.Identity?.IsAuthenticated == true)
          {
            <div class="user-avatar">@(User.Identity.Name?.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "ND")</div>
            <span class="user-name">@User.Identity.Name</span>
          }
          else
          {
            <div class="user-avatar" style="background: #64748b;">—</div>
            <span class="user-name" style="color: #64748b;">Chưa đăng nhập</span>
          }
        </a>
      </div>
    </header>

            <!-- SIDEBAR -->
    <aside class="app-sidebar" id="appSidebar">
      <div class="sidebar-nav-container">
        
        <div class="nav-item">
          <a href="/Productions/Home/Index" class="nav-link ">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a10 10 0 0 1 10 10H12V2z"></path>
              </svg>
            </span>
            <span class="nav-text">Tổng quan</span>
          </a>
        </div>

        <div class="nav-item">
          <a href="/Productions/Home/DrugOrder" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </span>
            <span class="nav-text">Đơn đặt hàng thuốc</span>
          </a>
        </div>

        <div class="nav-item has-sub open">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </span>
            <span class="nav-text">Kế hoạch sản xuất</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <a href="/Productions/Home/MaterialRequirement" class="sub-link">Tính nhu cầu nguyên vật liệu</a>
          </div>
        </div>

        <!-- Điều phối & thực thi (Đã xóa Lịch sản xuất, Tình hình giao hàng) -->
        <div class="nav-item has-sub open">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </span>
            <span class="nav-text">Điều phối & thực thi</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <!-- <a href="/Productions/Home/ProductionOrder" class="sub-link ">Lệnh sản xuất thuốc</a> -->
            <a href="/Productions/Home/MaterialRequisitionList" class="sub-link ">Xuất kho hoạt chất</a>
            <a href="/Productions/Home/ProductionStatisticsList" class="sub-link ">Thống kê sản xuất</a>
            <!-- <a href="/Productions/Home/FinishedGoodsReceiptList" class="sub-link ">Nhập kho thành phẩm</a> -->
            <a href="/Productions/Home/HandoverList" class="sub-link ">Bàn giao thành phẩm</a>
          </div>
        </div>

        <div class="nav-section-title">QUẢN TRỊ</div>

        

        <div class="nav-item">
          <a href="/Productions/Home/BomList" class="nav-link active">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </span>
            <span class="nav-text">Định mức công thức (BOM)</span>
          </a>
        </div>

      </div>

      <div class="sidebar-footer">
        <button type="button" class="btn-collapse-sidebar" id="sidebarCollapseBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="11 17 6 12 11 7"></polyline>
            <polyline points="18 17 13 12 18 7"></polyline>
          </svg>
          <span class="collapse-text">Thu gọn menu</span>
        </button>
      </div>
    </aside>

<main class="app-main"><div class="main-container page-fade-in">
<div class="bom-list-header"><h1 class="bom-page-title">Định mức công thức (BOM)</h1><a asp-action="BomCreate" class="btn-add-bom">+ Thêm công thức</a></div>
<p class="bom-hint">Mỗi dòng là một công thức. Chọn Xem để đọc công thức hoặc Sửa để cập nhật nguyên liệu cho 1 thành phẩm.</p>
@if (ViewBag.LoadError != null) { <div class="bom-alert" role="alert">@ViewBag.LoadError</div> }
<div class="bom-filter-bar"><input id="bomSearchInput" type="search" class="search-input" aria-label="Tìm công thức" placeholder="Tìm mã BOM, tên công thức, sản phẩm..." /></div>
<div class="bom-form-card"><div class="table-responsive"><table class="bom-table">
<thead><tr><th>Mã BOM</th><th>Tên công thức</th><th>Sản phẩm</th><th>Định mức cho</th><th>Số nguyên liệu</th><th>Đơn giá thành phẩm</th><th>Thời hạn sử dụng</th><th>Thao tác</th></tr></thead>
<tbody id="bomListTableBody">
@foreach (var formula in Model)
{
<tr data-bom-row><td><a class="bom-link" asp-action="BomDetail" asp-route-id="@formula.Id">@formula.Code</a></td><td>@formula.Name</td><td>@formula.ProductName <small class="bom-hint">(SP-@formula.ProductId)</small></td><td>1 @formula.Unit</td><td>@formula.MaterialCount</td><td>@httt.Models.BomEditorViewModel.Money(formula.ProductPrice)</td><td>@(formula.ShelfLifeMonths > 0 ? formula.ShelfLifeMonths.Value.ToString() : "Chưa nhập")</td><td><div class="bom-row-actions"><a class="bom-link" asp-action="BomDetail" asp-route-id="@formula.Id">Xem</a><a class="bom-link" asp-action="BomEdit" asp-route-id="@formula.Id">Sửa</a></div></td></tr>
}
<tr id="bomEmptyRow" hidden="@Model.Any()"><td colspan="8" class="bom-empty">@(ViewBag.LoadError == null ? "Không có công thức phù hợp." : "Dữ liệu tạm thời không khả dụng.")</td></tr>
</tbody></table></div><div class="table-footer-bar"><span>Hiển thị <strong id="bomVisibleCount">@Model.Count</strong> / @Model.Count công thức</span></div></div>
</div></main></div><script src="~/js/productions/list-search.js" asp-append-version="true"></script>
  <script src="~/js/app.js" asp-append-version="true"></script><script src="~/js/productions/bom.js" asp-append-version="true"></script></body></html>