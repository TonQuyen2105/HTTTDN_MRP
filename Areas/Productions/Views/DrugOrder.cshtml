    function openMarkModal(id, prodName, reqQty, currentProduced, unit, status) {
      if (status === 'Completed') {
        alert('Đơn hàng này đã hoàn thành đầy đủ số lượng yêu cầu (Completed). Không thể ghi nhận thêm.');
        return;
      }

      const remaining = Math.max(0, reqQty - currentProduced);

      document.getElementById('markRequestId').value = id;
      document.getElementById('markReqQty').value = reqQty;
      const prevProducedInput = document.getElementById('markPrevProducedVal');
      if (prevProducedInput) prevProducedInput.value = currentProduced;

      document.getElementById('markProductName').textContent = prodName;
      document.getElementById('markTargetQty').textContent = `${reqQty.toLocaleString()} ${unit}`;
      document.getElementById('markPrevQty').textContent = `${currentProduced.toLocaleString()} ${unit}`;
      document.getElementById('markUnitLabel').textContent = unit;

      const maxLabel = document.getElementById('markMaxAllowedLabel');
      if (maxLabel) maxLabel.textContent = remaining.toLocaleString();
      const maxUnit = document.getElementById('markMaxUnitLabel');
      if (maxUnit) maxUnit.textContent = unit;

      const tag = document.getElementById('markOrderCodeTag');
      if (tag) tag.textContent = `MÃ YÊU CẦU: ${productionRequestCodes[id] || 'Chưa có mã'}`;

      const inp = document.getElementById('inputProducedQty');
      inp.max = remaining;
      // Mặc định điền toàn bộ số lượng còn lại để người dùng tiện bấm lưu ngay
      inp.value = remaining > 0 ? remaining : 0;

      updateMarkProgress();
      document.getElementById('modalMarkBackdrop').classList.add('show');
    }

    function closeMarkModal() {
      document.getElementById('modalMarkBackdrop').classList.remove('show');
    }

    function setQuickBatchQty(ratio) {
      const reqQty = parseInt(document.getElementById('markReqQty').value || '0');
      const prevProduced = parseInt(document.getElementById('markPrevProducedVal')?.value || '0');
      const remaining = Math.max(0, reqQty - prevProduced);
      const qty = Math.max(1, Math.round(remaining * ratio));
      const finalVal = Math.min(qty, remaining);
      document.getElementById('inputProducedQty').value = finalVal;
      updateMarkProgress();
    }

    function getVerificationToken() {
      const token = document.querySelector('input[name="__RequestVerificationToken"]');
      return token ? token.value : '';
    }

    async function submitMarkProduced() {
      const btn = document.getElementById('btnSaveMark');
      if (btn.disabled) return;
      const reqId = parseInt(document.getElementById('markRequestId').value);
      const rawVal = document.getElementById('inputProducedQty').value;
      const batchQty = Number(rawVal);
      const prevProduced = parseInt(document.getElementById('markPrevProducedVal')?.value || '0');
      const reqQty = parseInt(document.getElementById('markReqQty').value || '0');
      const remaining = Math.max(0, reqQty - prevProduced);
      const unit = document.getElementById('markUnitLabel')?.textContent || 'Hộp';
      const note = document.getElementById('inputMarkNote').value.trim();

      if (rawVal === '' || !Number.isSafeInteger(batchQty) || batchQty <= 0) {
        alert('Vui lòng nhập số lượng ghi nhận lớn hơn 0.');
        return;
      }

      if (batchQty > remaining) {
        alert(`Số lượng ghi nhận (${batchQty.toLocaleString()} ${unit}) vượt quá số lượng yêu cầu còn lại (${remaining.toLocaleString()} ${unit}). Phần ghi nhận không được vượt quá số lượng yêu cầu của đơn!`);
        return;
      }

      if (note.length > 255) {
        alert('Ghi chú không được vượt quá 255 ký tự.');
        return;
      }

      if (!lastWipCanProduce) {
        if (!confirm(`Kho sản xuất hiện đang thiếu nguyên vật liệu theo định mức BOM để ghi nhận sản xuất ${batchQty.toLocaleString()} ${unit}. Bạn vẫn muốn gửi yêu cầu lên máy chủ để kiểm tra?`)) {
          return;
        }
      }

      btn.disabled = true;
      btn.textContent = 'Đang lưu ghi nhận...';

      try {
        const attemptStorageKey = `production-attempt-${reqId}`;
        const fingerprint = JSON.stringify([reqId, batchQty, note, prevProduced]);
        let attempt;
        try { attempt = JSON.parse(sessionStorage.getItem(attemptStorageKey) || 'null'); } catch { attempt = null; }
        if (!attempt || attempt.fingerprint !== fingerprint) {
          attempt = { fingerprint, key: crypto.randomUUID() };
          sessionStorage.setItem(attemptStorageKey, JSON.stringify(attempt));
        }
        const res = await fetch('/Productions/Home/MarkProducedGoods', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': getVerificationToken()
          },
          body: JSON.stringify({
            requestId: reqId,
            producedQuantity: batchQty,
            quantityToProduce: batchQty,
            operationKey: attempt.key,
            isCompleted: (prevProduced + batchQty >= reqQty),
            note: note
          })
        });

        if (res.status === 401) {
          alert('Phiên làm việc đã hết hạn hoặc bạn chưa đăng nhập. Vui lòng đăng nhập lại.');
          window.location.href = '/Account/Login';
          return;
        }
        if (res.status === 403) {
          alert('Bạn không có quyền thực hiện chức năng này.');
          return;
        }

        let data;
        try {
          data = await res.json();
        } catch (e) {
          data = { success: false, message: 'Lỗi phản hồi từ máy chủ (' + res.status + ')' };
        }

        if (res.ok && data && data.success) {
          sessionStorage.removeItem(attemptStorageKey);
          alert('✅ ' + data.message);
          closeMarkModal();
          window.location.reload();
        } else {
          // Khi lỗi: Hiển thị lỗi từ server (ví dụ danh sách NVL bị thiếu hoặc vượt quá yêu cầu), KHÔNG đóng modal, giữ nguyên giá trị đã nhập
          alert('❌ ' + (data && data.message ? data.message : 'Không thể ghi nhận sản lượng.'));
        }
      } catch (err) {
        alert('❌ Lỗi kết nối máy chủ: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Lưu ghi nhận sản lượng`;
      }
    }

