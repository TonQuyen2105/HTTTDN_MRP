          data = await res.json();
        } catch (e) {
          data = { success: false, message: 'Lỗi phản hồi từ máy chủ (' + res.status + ')' };
        }

        if (res.ok && data && data.success) {
          alert('✅ ' + data.message);
          closeCreateModal();
          window.location.reload();
        } else {
          alert('❌ ' + (data && data.message ? data.message : 'Không thể tiếp nhận đơn.'));
        }
      } catch (err) {
        alert('❌ Lỗi kết nối: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Xác nhận tiếp nhận đơn';
      }
    }
  </script>
</body>
</html>
