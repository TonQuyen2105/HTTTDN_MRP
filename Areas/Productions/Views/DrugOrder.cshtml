@model IEnumerable<httt.Models.ProductionRequest>
@{
    Layout = null;
    ViewData["Title"] = "AMIS Sản xuất - Đơn đặt hàng thuốc";
    var allOrders = Model ?? new List<httt.Models.ProductionRequest>();
    var pendingList = ViewBag.PendingRequests as IEnumerable<httt.Models.ProductionRequest> ?? allOrders.Where(m => m.Status == "Pending").ToList();
    var pendingOrders = pendingList.Count();
    var acceptedOrders = allOrders.Where(m => m.Status != "Pending").ToList();
    var totalAccepted = acceptedOrders.Count;
    var inProgOrders = acceptedOrders.Count(m => m.Status == "In Production" || m.Status == "Approved");
    var completedOrders = acceptedOrders.Count(m => m.Status == "Completed");
    var totalQtyRequired = acceptedOrders.Sum(m => (long)m.QuantityRequired);
    var totalQtyCompleted = acceptedOrders.Where(m => m.Status == "Completed").Sum(m => (long)m.QuantityRequired);
    var products = ViewBag.Products as IEnumerable<httt.Models.Product> ?? new List<httt.Models.Product>();
    var managers = ViewBag.Managers as IEnumerable<httt.Models.UserAccount> ?? new List<httt.Models.UserAccount>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  
  <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/productions/production-order.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/productions/drug-order.css" asp-append-version="true" />
</head>
<body class="drug-order-page">
  <div class="app-wrapper">
    
    <!-- TOP HEADER -->
    <header class="app-header">
      <div class="header-left">
        <button type="button" class="btn-sidebar-toggle" id="sidebarToggleBtn" title="Đóng/Mở menu">
