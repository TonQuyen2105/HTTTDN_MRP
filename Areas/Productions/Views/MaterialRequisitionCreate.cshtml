@model httt.Models.MaterialReceipt?
@{
    Layout = null;
    var isViewMode = Model != null;
    var receiptCode = Model != null ? Model.DisplayCode : "— Tự sinh khi lập từ MRP —";
    var reqDisplayCode = !string.IsNullOrWhiteSpace(Model?.ProductionRequest?.RequestCode)
        ? Model.ProductionRequest.RequestCode
        : (Model?.RequestId.HasValue == true ? $"YCSX-{Model.RequestId}" : (!string.IsNullOrWhiteSpace(Model?.ProductionOrderCode) ? Model.ProductionOrderCode : "—"));
    var productName = Model?.ProductionRequest?.Product?.ProductName;
    var orderWithProduct = reqDisplayCode != "—"
        ? (!string.IsNullOrWhiteSpace(productName) ? $"{reqDisplayCode} - {productName}" : reqDisplayCode)
        : "—";
    var orderCode = orderWithProduct;
    var requesterName = Model?.Requester?.FullName ?? (User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Chưa cập nhật");
    var createDateStr = Model?.CreatedDate?.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy");
    var requireDateStr = Model?.RequiredDate?.ToString("dd/MM/yyyy") ?? "—";

    var wipDict = ViewBag.WipDict as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();

    // Phiếu được coi là đã cấp (Completed / Approved / Được cấp) hoặc khi toàn bộ dòng đã nạp đủ trong wip_inventory
    var isFulfilled = Model?.Status == "Completed" || Model?.Status == "Approved" || Model?.Status == "Được cấp";
    if (!isFulfilled && Model?.Details != null && Model.Details.Any())
    {
        isFulfilled = Model.Details.All(d => wipDict.TryGetValue(d.IngrId, out var wQty) && wQty >= d.Quantity);
    }

    var statusText = isFulfilled ? "Được cấp" : (Model?.Status == "Processing" ? "Đang xử lý" : "Chờ cấp");
    var statusBadgeClass = isFulfilled ? "badge-status-done" : "badge-status-waiting";
    var noteText = Model?.Note ?? "";
    var bomName = Model?.BomName ?? "—";
}
<!DOCTYPE html>
<html lang="vi">
