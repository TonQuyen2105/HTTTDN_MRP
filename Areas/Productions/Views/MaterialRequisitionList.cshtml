@model IEnumerable<httt.Models.MaterialReceipt>
@{
    Layout = null;
    ViewData["Title"] = "AMIS Sản xuất Dược phẩm - Xuất kho hoạt chất & nguyên phụ liệu";
}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AMIS Sản xuất - Yêu cầu xuất vật tư</title>
  
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/productions/production-order.css">
  <link rel="stylesheet" href="/css/productions/production-statistics.css">
  <link rel="stylesheet" href="/css/productions/material-requisition.css">
</head>
<body>
  <div class="app-wrapper">
    
    <!-- TOP HEADER -->
    <header class="app-header">
      <div class="header-left">
        <button type="button" class="btn-sidebar-toggle" id="sidebarToggleBtn" title="Đóng/Mở menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <a href="/Productions/Home/Index" class="app-brand" style="text-decoration: none; color: inherit;">
          <div class="app-brand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 20h20"></path>
              <path d="M5 20V8l5 4V8l5 4V4h4v16"></path>
            </svg>
          </div>
          <span class="app-brand-name">Sản xuất Dược</span>
        </a>
      </div>

      <div class="header-right">
        <div class="branch-selector" title="Chọn chi nhánh làm việc">
          <span>Chi nhánh:</span>
          <strong>Nhà máy Dược phẩm GMP Nam Hà</strong>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>

        <div class="header-actions">
          <button type="button" class="icon-btn" title="Cài đặt hệ thống">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1-1.51H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1 1.51z"></path>
            </svg>
          </button>
          <button type="button" class="icon-btn" title="Trợ giúp & Hướng dẫn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></button>
          <button type="button" class="icon-btn" title="Thông báo"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg><span class="badge-dot"></span></button>
        </div>
        <a href="/Productions/Home/UserProfile" class="user-profile" title="Xem thông tin cá nhân" style="text-decoration:none;">
          @if (User.Identity?.IsAuthenticated == true)
          {
            <div class="user-avatar">@(User.Identity.Name?.Length >= 2 ? User.Identity.Name.Substring(0, 2).ToUpper() : "ND")</div>
            <span class="user-name">@User.Identity.Name</span>
          }
          else
          {
            <div class="user-avatar" style="background: #64748b;">—</div>
            <span class="user-name" style="color: #64748b;">Chưa đăng nhập</span>
          }
        </a>
      </div>
    </header>

            <!-- SIDEBAR -->
    <aside class="app-sidebar" id="appSidebar">
      <div class="sidebar-nav-container">
        
        <div class="nav-item">
          <a href="/Productions/Home/Index" class="nav-link ">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a10 10 0 0 1 10 10H12V2z"></path>
              </svg>
            </span>
            <span class="nav-text">Tổng quan</span>
          </a>
        </div>

        <div class="nav-item">
          <a href="/Productions/Home/DrugOrder" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </span>
            <span class="nav-text">Đơn đặt hàng thuốc</span>
          </a>
        </div>

        <div class="nav-item has-sub open">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </span>
            <span class="nav-text">Kế hoạch sản xuất</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <a href="/Productions/Home/MaterialRequirement" class="sub-link">Tính nhu cầu nguyên vật liệu</a>
          </div>
        </div>

        <!-- Điều phối & thực thi (Đã xóa Lịch sản xuất, Tình hình giao hàng) -->
        <div class="nav-item has-sub open">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </span>
            <span class="nav-text">Điều phối & thực thi</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <!-- <a href="/Productions/Home/ProductionOrder" class="sub-link ">Lệnh sản xuất thuốc</a> -->
            <a href="/Productions/Home/MaterialRequisitionList" class="sub-link active">Xuất kho hoạt chất</a>
            <a href="/Productions/Home/ProductionStatisticsList" class="sub-link ">Thống kê sản xuất</a>
            <!-- <a href="/Productions/Home/FinishedGoodsReceiptList" class="sub-link ">Nhập kho thành phẩm</a> -->
            <a href="/Productions/Home/HandoverList" class="sub-link ">Bàn giao thành phẩm</a>
          </div>
        </div>

        <div class="nav-section-title">QUẢN TRỊ & BÁO CÁO</div>

        <div class="nav-item has-sub">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </span>
            <span class="nav-text">Báo cáo</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <a href="#" class="sub-link">Báo cáo tiến độ lô SX</a>
            <a href="#" class="sub-link">Báo cáo hao hụt hoạt chất</a>
          </div>
        </div>

        <div class="nav-item">
          <a href="/Productions/Home/BomList" class="nav-link ">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </span>
            <span class="nav-text">Định mức công thức (BOM)</span>
          </a>
        </div>

      </div>

      <div class="sidebar-footer">
        <button type="button" class="btn-collapse-sidebar" id="sidebarCollapseBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="11 17 6 12 11 7"></polyline>
            <polyline points="18 17 13 12 18 7"></polyline>
          </svg>
          <span class="collapse-text">Thu gọn menu</span>
        </button>
      </div>
    </aside>

    <!-- NỘI DUNG CHÍNH (DANH SÁCH YÊU CẦU XUẤT VẬT TƯ) -->
    <main class="app-main">
      <div class="main-container page-fade-in">
        
        <div class="mr-list-header">
          <h1 class="mr-page-title">Yêu cầu xuất vật tư</h1>
          <div>
            <a href="/Productions/Home/MaterialRequisitionCreate" class="btn-add-mr">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              Lập yêu cầu xuất vật tư
            </a>
          </div>
        </div>

        <!-- Filter bar -->
        <div class="handover-filter-bar">
          <div class="search-input-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="mrSearchInput" class="search-input" placeholder="Tìm theo số phiếu, mã đơn/phiếu kho, người yêu cầu...">
          </div>

          <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
            <div style="display: flex; gap: 8px; align-items: center;">
              <span style="font-size: 13px; color: #64748b;">Trạng thái:</span>
              <select class="form-select" style="width: 170px; height: 32px;">
                <option selected>Tất cả trạng thái</option>
                <option>Chờ cấp</option>
                <option>Được cấp</option>
              </select>
            </div>
          </div>
        </div>

        <!-- BẢNG DANH SÁCH YÊU CẦU XUẤT VẬT TƯ -->
        <div class="mr-table-card">
          <div class="table-responsive">
            <table class="bom-table">
              <thead>
                <tr>
                  <th class="text-center" style="width: 50px;">STT</th>
                  <th>Số phiếu</th>
                  <th>Ngày yêu cầu</th>
                  <th>Mã đơn / Phiếu kho</th>
                  <th>Sản phẩm sản xuất</th>
                  <th>Bộ phận yêu cầu</th>
                  <th>Người yêu cầu</th>
                  <th>Ngày cần</th>
                  <th class="text-center">Trạng thái</th>
                  <th class="text-center" style="width: 80px;">Thao tác</th>
                </tr>
              </thead>
              <tbody id="mrListBody">
                @if (Model != null && Model.Any())
                {
                    int stt = 1;
                    foreach (var item in Model)
                    {
                        var firstDetail = item.Details.FirstOrDefault();
                        var prodName = item.ProductionRequest?.Product?.ProductName ?? firstDetail?.Note ?? "Xuất hoạt chất & tá dược";
                        var reqCode = !string.IsNullOrWhiteSpace(item.ProductionRequest?.RequestCode)
                            ? item.ProductionRequest.RequestCode
                            : (item.RequestId.HasValue ? $"YCSX-{item.RequestId}" : (!string.IsNullOrWhiteSpace(item.ProductionOrderCode) ? item.ProductionOrderCode : "—"));
                        var receiptLabel = item.DisplayCode;
                        var isDone = item.Status == "Completed" || item.Status == "Approved" || item.Status == "Được cấp";
                        <tr>
                          <td class="text-center">@stt</td>
                          <td><a href="/Productions/Home/MaterialRequisitionCreate?id=@item.ExpReceiptId" style="color:var(--color-primary); font-weight:700;">@receiptLabel</a></td>
                          <td>@(item.CreatedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                          <td>
                            @if (item.RequestId.HasValue)
                            {
                              <a href="/Productions/Home/DrugOrder" style="color:#059669; font-weight:700; text-decoration: none;" title="Xem đơn đặt hàng thuốc">@reqCode</a>
                            }
                            else
                            {
                              <span style="color:#64748b;">@reqCode</span>
                            }
                          </td>
                          <td>@prodName</td>
                          <td>Phân xưởng Bào chế GMP</td>
                          <td>@(item.Requester?.FullName ?? "—")</td>
                          <td>@(item.RequiredDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                          <td class="text-center">
                            @if (isDone)
                            {
                                <span class="badge-status-done" style="background:#ecfdf5; color:#047857; border: 1px solid #a7f3d0; font-weight: 600;">Được cấp</span>
                            }
                            else
                            {
                                <span class="badge-status-waiting">Chờ cấp</span>
                            }
                          </td>
                          <td class="text-center">
                            <div class="row-actions-cell">
                              <a href="/Productions/Home/MaterialRequisitionCreate?id=@item.ExpReceiptId" class="btn-action-view" title="Xem chi tiết phiếu yêu cầu">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                  <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                              </a>
                            </div>
                          </td>
                        </tr>
                        stt++;
                    }
                }
                else
                {
                    <tr>
                      <td colspan="10" style="text-align: center; color: #64748b; font-style: italic; padding: 32px;">
                        Chưa có phiếu xuất kho hoạt chất nào trong hệ thống
                      </td>
                    </tr>
                }
              </tbody>
            </table>
          </div>

          <div class="table-footer-bar">
            <span>Tổng số: <strong>@(Model?.Count() ?? 0)</strong> phiếu</span>
            <div class="table-footer-right">
              <span>Số dòng/trang</span>
              <select class="form-select" style="width: 75px; height: 26px; padding: 0 4px; font-size: 12px;">
                <option selected>20</option>
                <option>50</option>
                <option>100</option>
              </select>
              <span>1 - 2</span>
              <button type="button" class="pagination-btn">&lt;</button>
              <button type="button" class="pagination-btn">&gt;</button>
            </div>
          </div>
        </div>

      </div>
    </main>

  </div>

  <script src="/js/app.js"></script>
  <script src="/js/productions/material-requisition.js"></script>
</body>
</html>
