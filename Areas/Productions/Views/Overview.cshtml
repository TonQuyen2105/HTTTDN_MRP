@{
    Layout = null; // Hoặc Layout = "~/Views/Shared/_Layout.cshtml"; nếu tích hợp chung
    ViewData["Title"] = "AMIS Sản xuất - Tổng quan phân hệ Sản xuất";
}

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  
  <!-- CSS dùng chung -->
  <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
  
  <!-- CSS riêng cho phân hệ Productions -->
  <link rel="stylesheet" href="~/css/productions/overview.css" asp-append-version="true" />

  <!-- Thư viện biểu đồ Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
  <div class="app-wrapper">
    
    <!-- HEADER -->
    <header class="app-header">
      <div class="header-left">
        <button type="button" class="btn-sidebar-toggle" id="sidebarToggleBtn" title="Đóng/Mở menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <a href="/Productions/Home/Index" class="app-brand" style="text-decoration: none; color: inherit;">
          <div class="app-brand-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M2 20h20"></path>
              <path d="M5 20V8l5 4V8l5 4V4h4v16"></path>
            </svg>
          </div>
          <span class="app-brand-name">Sản xuất Dược</span>
        </a>
      </div>

      <div class="header-right">
        <div class="branch-selector" title="Chọn chi nhánh làm việc">
          <span>Chi nhánh:</span>
          <strong>Nhà máy Dược phẩm GMP Nam Hà</strong>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>

        <div class="header-actions">
          <button type="button" class="icon-btn" title="Cài đặt hệ thống">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </button>

          <button type="button" class="icon-btn" title="Trợ giúp & Hướng dẫn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </button>

          <button type="button" class="icon-btn" title="Thông báo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="badge-dot"></span>
          </button>
        </div>

        <a href="/Productions/Home/UserProfile" class="user-profile" style="text-decoration: none; color: inherit;" title="Tài khoản cá nhân">
          <div class="user-avatar">MT</div>
          <span class="user-name">DS. Nguyễn Minh Tài</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
      </div>
    </header>

            <!-- SIDEBAR -->
    <aside class="app-sidebar" id="appSidebar">
      <div class="sidebar-nav-container">
        
        <div class="nav-item">
          <a href="/Productions/Home/Index" class="nav-link active">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a10 10 0 0 1 10 10H12V2z"></path>
              </svg>
            </span>
            <span class="nav-text">Tổng quan</span>
          </a>
        </div>

        <div class="nav-item">
          <a href="/Productions/Home/DrugOrder" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </span>
            <span class="nav-text">Đơn đặt hàng thuốc</span>
          </a>
        </div>

        <div class="nav-item has-sub open">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </span>
            <span class="nav-text">Kế hoạch sản xuất</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <a href="/Productions/Home/MaterialRequirement" class="sub-link">Tính nhu cầu nguyên vật liệu</a>
          </div>
        </div>

        <!-- Điều phối & thực thi (Đã xóa Lịch sản xuất, Tình hình giao hàng) -->
        <div class="nav-item has-sub open">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </span>
            <span class="nav-text">Điều phối & thực thi</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <a href="/Productions/Home/ProductionOrder" class="sub-link ">Lệnh sản xuất thuốc</a>
            <a href="/Productions/Home/MaterialRequisitionList" class="sub-link ">Xuất kho hoạt chất</a>
            <a href="/Productions/Home/ProductionStatisticsList" class="sub-link ">Thống kê sản xuất</a>
            <!-- <a href="/Productions/Home/FinishedGoodsReceiptList" class="sub-link ">Nhập kho thành phẩm</a> -->
            <a href="/Productions/Home/HandoverList" class="sub-link ">Bàn giao thành phẩm</a>
          </div>
        </div>

        <div class="nav-section-title">QUẢN TRỊ & BÁO CÁO</div>

        <div class="nav-item has-sub">
          <a href="#" class="nav-link">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </span>
            <span class="nav-text">Báo cáo</span>
            <svg class="nav-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>
          <div class="sub-menu">
            <a href="#" class="sub-link">Báo cáo tiến độ lô SX</a>
            <a href="#" class="sub-link">Báo cáo hao hụt hoạt chất</a>
          </div>
        </div>

        <div class="nav-item">
          <a href="/Productions/Home/BomList" class="nav-link ">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </span>
            <span class="nav-text">Định mức công thức (BOM)</span>
          </a>
        </div>

      </div>

      <div class="sidebar-footer">
        <button type="button" class="btn-collapse-sidebar" id="sidebarCollapseBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="11 17 6 12 11 7"></polyline>
            <polyline points="18 17 13 12 18 7"></polyline>
          </svg>
          <span class="collapse-text">Thu gọn menu</span>
        </button>
      </div>
    </aside>

    <!-- MAIN DASHBOARD -->
    <main class="app-main">
      <div class="main-container">

        <!-- 1. Banner Onboarding -->
        <section class="welcome-banner" id="welcomeBanner">
          <div class="welcome-banner-left">
            <div class="progress-circle-wrap">
              <svg class="progress-circle" viewBox="0 0 36 36">
                <path class="bg-ring" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                <path class="progress-ring" stroke-dasharray="20, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              </svg>
              <span class="progress-text">20%</span>
            </div>
            
            <div class="welcome-info">
              <h2 class="welcome-title">Chào AMIS Sản xuất, hoàn thành các bước bắt đầu sử dụng để biết cách sử dụng phần mềm nhé !</h2>
              <a href="#" class="welcome-action-link">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                Bắt đầu sử dụng
              </a>
            </div>
          </div>

          <button type="button" class="btn-dismiss-banner" id="btnDismissBanner" title="Bỏ qua hướng dẫn">
            ✕ Đã biết sử dụng
          </button>
        </section>

        <!-- 2. Thanh lọc dữ liệu -->
        <section class="filter-toolbar">
          <div class="filter-group-list">
            
            <div class="filter-select-box" tabindex="0">
              <span class="filter-label">Đơn vị sản xuất:</span>
              <span class="filter-value">Nhà máy Dược phẩm GMP Nam Hà</span>
              <span class="filter-chevron">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="7 15 12 20 17 15"></polyline>
                  <polyline points="7 9 12 4 17 9"></polyline>
                </svg>
              </span>
            </div>

            <div class="filter-select-box" tabindex="0">
              <span class="filter-label">Thời gian:</span>
              <span class="filter-value">Năm nay</span>
              <span class="filter-chevron">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="7 15 12 20 17 15"></polyline>
                  <polyline points="7 9 12 4 17 9"></polyline>
                </svg>
              </span>
            </div>

            <div class="filter-select-box" tabindex="0">
              <span class="filter-label">Nhóm sản phẩm:</span>
              <span class="filter-value">Tất cả</span>
              <span class="filter-chevron">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="7 15 12 20 17 15"></polyline>
                  <polyline points="7 9 12 4 17 9"></polyline>
                </svg>
              </span>
            </div>

          </div>

          <button type="button" class="btn-customize">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="4" y1="21" x2="4" y2="14"></line>
              <line x1="4" y1="10" x2="4" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12" y2="3"></line>
              <line x1="20" y1="21" x2="20" y2="16"></line>
              <line x1="20" y1="12" x2="20" y2="3"></line>
              <line x1="1" y1="14" x2="7" y2="14"></line>
              <line x1="9" y1="8" x2="15" y2="8"></line>
              <line x1="17" y1="16" x2="23" y2="16"></line>
            </svg>
            Tùy chỉnh
          </button>
        </section>

        <!-- 3. Hàng KPI Sản xuất Dược phẩm -->
        <section class="stats-grid">
          
          <article class="stat-card">
            <div class="stat-header">
              <span class="stat-title">LÔ SX ĐANG THỰC HIỆN</span>
              <div class="stat-icon-badge badge-orange">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>
            </div>

            <div class="stat-value">@(ViewBag.TotalRequests ?? 5)</div>

            <div class="stat-subtext">
              <span class="stat-percent-badge">100%</span>
              <span>Tổng yêu cầu sản xuất thuốc</span>
            </div>

            <div class="stat-footer">
              <span>Số liệu tính đến: <strong class="stat-time-val">Hôm nay</strong></span>
              <button type="button" class="btn-refresh-stat" title="Làm mới dữ liệu">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
              </button>
            </div>
          </article>

          <article class="stat-card">
            <div class="stat-header">
              <span class="stat-title">LỆNH CHỜ PHÊ DUYỆT / CHƯA XONG</span>
              <div class="stat-icon-badge badge-yellow">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
              </div>
            </div>

            <div class="stat-value">@(ViewBag.PendingRequests ?? 4)</div>

            <div class="stat-subtext">
              <span class="stat-percent-badge">80,00%</span>
              <span>Tổng số lệnh chờ sản xuất: 5</span>
            </div>

            <div class="stat-footer">
              <span>Số liệu tính đến: <strong class="stat-time-val">Hôm nay</strong></span>
              <button type="button" class="btn-refresh-stat" title="Làm mới dữ liệu">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
              </button>
            </div>
          </article>

          <article class="stat-card">
            <div class="stat-header">
              <span class="stat-title">SẢN LƯỢNG THUỐC CẦN SẢN XUẤT</span>
              <div class="stat-icon-badge badge-blue">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 2a10 10 0 0 1 10 10H12V2z"></path>
                </svg>
              </div>
            </div>

            <div class="stat-value">@((ViewBag.TotalQuantityRequired ?? 0).ToString("N0")) Hộp</div>

            <div class="stat-subtext">
              <span class="stat-percent-badge">Kho</span>
              <span>Tồn kho hoạt chất: @(ViewBag.TotalStock ?? 890) kg (@(ViewBag.TotalIngredients ?? 8) loại)</span>
            </div>

            <div class="stat-footer">
              <span>Số liệu tính đến: <strong class="stat-time-val">Hôm nay</strong></span>
              <button type="button" class="btn-refresh-stat" title="Làm mới dữ liệu">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
                </svg>
              </button>
            </div>
          </article>

        </section>

        <!-- 4. Biểu đồ -->
        <section class="charts-grid">
          
          <article class="chart-card">
            <div class="chart-header">
              <h3 class="chart-title">Top 10 Sản phẩm có sản lượng cao nhất</h3>
              <select class="chart-filter-select">
                <option value="year" selected>Năm nay</option>
                <option value="quarter">Quý này</option>
                <option value="month">Tháng này</option>
              </select>
            </div>
            
            <div class="chart-body">
              <canvas id="topProductsChart"></canvas>
            </div>
          </article>

          <article class="chart-card">
            <div class="chart-header">
              <h3 class="chart-title">Lệnh sản xuất theo trạng thái</h3>
              <select class="chart-filter-select">
                <option value="year" selected>Năm nay</option>
                <option value="quarter">Quý này</option>
                <option value="month">Tháng này</option>
              </select>
            </div>

            <div class="chart-body">
              <div class="donut-chart-container">
                <div class="donut-canvas-wrap">
                  <canvas id="orderStatusChart"></canvas>
                </div>
                
                <ul class="donut-legend-list">
                  <li class="donut-legend-item">
                    <span class="donut-legend-color" style="background-color: #8f9bb3;"></span>
                    <span>Chưa sản xuất</span>
                  </li>
                  <li class="donut-legend-item">
                    <span class="donut-legend-color" style="background-color: #34a853;"></span>
                    <span>Đang sản xuất</span>
                  </li>
                  <li class="donut-legend-item">
                    <span class="donut-legend-color" style="background-color: #3b82f6;"></span>
                    <span>Đã hoàn thành</span>
                  </li>
                  <li class="donut-legend-item">
                    <span class="donut-legend-color" style="background-color: #f59e0b;"></span>
                    <span>Tạm dừng</span>
                  </li>
                  <li class="donut-legend-item">
                    <span class="donut-legend-color" style="background-color: #e54848;"></span>
                    <span>Hủy bỏ</span>
                  </li>
                </ul>
              </div>
            </div>
          </article>

        </section>

      </div>
    </main>

  </div>

  <!-- Javascript -->
  <script>
    window.dbTopProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      ((IEnumerable<httt.Models.Product>)(ViewBag.TopProducts ?? new List<httt.Models.Product>()))
        .Select(p => new { name = p.ProductName, qty = p.Quantity })
    ));
    window.dbStatusCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      ViewBag.StatusCounts ?? new object[0]
    ));
  </script>
  <script src="~/js/app.js" asp-append-version="true"></script>
  <script src="~/js/productions/overview.js" asp-append-version="true"></script>
</body>
</html>
