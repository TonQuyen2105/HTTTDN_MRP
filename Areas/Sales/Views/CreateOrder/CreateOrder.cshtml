@model IEnumerable<httt.Models.SaleOrder>
@{
    ViewData["Title"] = "Tạo phiếu xuất kho thành phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var ordersList = Model?.ToList() ?? new List<httt.Models.SaleOrder>();
    var selectedOrder = ViewBag.SelectedOrder as httt.Models.SaleOrder ?? ordersList.FirstOrDefault();
    var exportReceipts = ViewBag.ExportReceipts as List<httt.Models.ProductExportReceipt> ?? new List<httt.Models.ProductExportReceipt>();
    var orderLookupFull = ViewBag.OrderLookupFull as Dictionary<int, (string Code, string Customer, string Status)> ?? new Dictionary<int, (string Code, string Customer, string Status)>();
    var orderLookup = ViewBag.OrderLookup as Dictionary<int, (string Code, string Customer)> ?? new Dictionary<int, (string Code, string Customer)>();

    var existingReceipt = ViewBag.ExistingReceipt as httt.Models.ProductExportReceipt;
    
    // Kiểm tra trạng thái đơn hàng bị hủy
    bool isOrderCancelled = selectedOrder != null && (
        string.Equals(selectedOrder.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ||
        selectedOrder.Status == "Đã hủy"
    );

    // Kiểm tra phiếu xuất trước đó bị từ chối
    bool isLatestRejected = existingReceipt != null && (
        string.Equals(existingReceipt.Status, "Rejected", StringComparison.OrdinalIgnoreCase) ||
        existingReceipt.Status == "Từ chối"
    );

    var isSent = existingReceipt != null && !isLatestRejected && !isOrderCancelled;
    var receiptCode = (isSent && existingReceipt != null) 
        ? existingReceipt.Expreceiptcode 
        : $"PXTP{Guid.NewGuid().ToString("N")[..8].ToUpper()}";

    bool isOrderCompleted = selectedOrder != null && (
        string.Equals(selectedOrder.Status, "Completed", StringComparison.OrdinalIgnoreCase) ||
        selectedOrder.Status == "Đã xong" ||
        selectedOrder.Status == "Đã hoàn thành"
    );

    bool isWarehouseDone = existingReceipt != null && (
        string.Equals(existingReceipt.Status, "Completed", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(existingReceipt.Status, "Exported", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(existingReceipt.Status, "Approved", StringComparison.OrdinalIgnoreCase) ||
        existingReceipt.Status == "Tán thành" ||
        existingReceipt.Status == "Đã xuất kho"
    );
}

@section Styles {
    <link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/create-order.css" asp-append-version="true" />
}

<div class="order-page">
    <div class="order-workspace">

        <!-- SIDEBAR -->
        <aside class="order-sidebar">
            <div class="order-sidebar-brand">
                <h2>PharmaMRP</h2>
                <span>HỆ THỐNG BÁN HÀNG</span>
            </div>

            <div class="order-sidebar-label">MENU BÁN HÀNG</div>

            <nav class="order-sidebar-nav">
                <a class="order-nav-item" href="/Sales/Orders">
                    <span>Xem đơn hàng</span>
                </a>
                <a class="order-nav-item active" href="/Sales/CreateOrder">
                    <span>Tạo phiếu xuất thành phẩm</span>
                </a>
                <a class="order-nav-item" href="/Sales/TransactionHistory">
                    <span>Lịch sử đơn hàng</span>
                </a>
                <a class="order-nav-item" href="/Sales/ExportSlips">
                    <span>Theo dõi phiếu xuất kho</span>
                </a>
                <a class="order-nav-item" href="/Sales/MedicineInventory">
                    <span>Tra cứu thuốc và tồn kho</span>
                </a>
                <a class="order-nav-item" href="/Sales/SalesAccount">
                    <span>Tài khoản của tôi</span>
                </a>
                <a class="order-nav-item" href="/Sales/RevenueReport">
                    <span>Thống kê, báo cáo doanh thu</span>
                </a>
            </nav>

            <div class="sidebar-status-box">
                <div class="sidebar-status-title">Hạ tầng hệ thống</div>
                <div class="status-indicator-item">
                    <span>Kết nối DB:</span>
                    <span class="status-dot-active">● Supabase Online</span>
                </div>
                <div class="status-indicator-item">
                    <span>Kho thuốc:</span>
                    <span style="color: #0284C7; font-weight: 700;">● Sẵn sàng xuất</span>
                </div>
                <div class="status-indicator-item">
                    <span>Bộ nhớ đệm:</span>
                    <span>● Trực tiếp DB</span>
                </div>
            </div>

            <div class="order-sidebar-bottom">
                <div class="order-user-info">
                    <strong>@(User.FindFirst("FullName")?.Value ?? "Nhân viên bán hàng")</strong>
                    <span>@(User.Identity?.Name ?? "sales_user") • Pharma Store</span>
                </div>
                <a href="/Account/LogoutGet" style="display: block; margin-top: 8px; padding: 6px 10px; text-align: center; background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA; border-radius: 6px; font-size: 12px; font-weight: 600; text-decoration: none;">
                    Đăng xuất
                </a>
            </div>
        </aside>

        <!-- NỘI DUNG CHÍNH -->
        <main class="order-main">

            <div class="order-heading">
                <div>
                    <div class="order-breadcrumb">
                        <span>Trang chủ</span> / <span>Bán hàng</span> / <strong>Tạo phiếu xuất thành phẩm</strong>
                    </div>
                    <h1>Phiếu yêu cầu xuất kho thành phẩm</h1>
                    <p>Chọn mã đơn hàng để lập lệnh xuất thuốc và chuyển trực tiếp sang bộ phận Kho.</p>
                </div>
            </div>

            <!-- THANH CHỌN ĐƠN HÀNG -->
            <section class="co-clean-card co-single-row-bar">
                <div class="single-row-content">
                    <label for="selectOrderDropdown" class="single-row-label">Chọn mã đơn:</label>
                    
                    <div class="single-row-select-wrapper">
                        <select id="selectOrderDropdown" class="form-select co-simple-select">
                            @if (!ordersList.Any())
                            {
                                <option value="">-- Chưa có đơn hàng khả dụng --</option>
                            }
                            else
                            {
                                @foreach (var ord in ordersList)
                                {
                                    var isSel = selectedOrder != null && selectedOrder.Orderid == ord.Orderid;
                                    <option value="@ord.Orderid" selected="@(isSel ? "selected" : null)">
                                        @(ord.Ordercode ?? ("DH-" + ord.Orderid)) - @ord.Customername
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <button type="button" class="btn-select-confirm" onclick="applySelectedOrder()">
                        Chọn
                    </button>

                    <button type="button" class="btn-clean-outline" onclick="openOrderModal()">
                        Danh sách đơn
                    </button>
                    
                    <a href="/Sales/Order/GenerateMockOrders" class="btn-clean-primary-soft">
                        + Tạo đơn mẫu
                    </a>

                    <div class="single-row-receipt-code">
                        <span>Mã phiếu: <strong>@(isOrderCancelled ? "ĐÃ HỦY" : receiptCode)</strong></span>
                    </div>
                </div>
            </section>

            <!-- CHI TIẾT ĐƠN HÀNG & MỤC YÊU CẦU XUẤT KHO -->
            <section class="co-clean-card">
                <div class="co-card-title-bar">
                    <h2>Chi tiết đơn hàng</h2>
                </div>

                @if (selectedOrder == null)
                {
                    <div class="order-empty-box">
                        <p>Vui lòng chọn một mã đơn hàng ở phía trên và bấm <strong>Chọn</strong> để tải dữ liệu chi tiết.</p>
                    </div>
                }
                else
                {
                    @if (isOrderCancelled)
                    {
                        <!-- THÔNG BÁO ĐƠN HÀNG BỊ HỦY -->
                        <div class="alert-box alert-danger" style="margin-bottom: 14px;">
                            <span>⚠</span>
                            <span><strong>Thông báo:</strong> Đơn hàng này (<code>@(selectedOrder.Ordercode ?? ("DH-" + selectedOrder.Orderid))</code>) đã bị hủy, không còn phiếu xuất. Toàn bộ quy trình điều phối và giao hàng đã chấm dứt.</span>
                        </div>
                    }
                    else if (isLatestRejected)
                    {
                        <!-- THÔNG BÁO PHIẾU XUẤT CŨ BỊ TỪ CHỐI -->
                        <div class="alert-box alert-danger" style="margin-bottom: 14px;">
                            <span>⚠</span>
                            <span><strong>Thông báo:</strong> Phiếu xuất trước đó (<code>@existingReceipt?.Expreceiptcode</code>) đã bị Kho từ chối. Bạn có thể bấm nút bên dưới để tạo lại phiếu xuất mới cho đơn này.</span>
                        </div>
                    }

                    <!-- THÔNG TIN ĐƠN VỊ NHẬN HÀNG -->
                    <div class="co-order-brief">
                        <div class="brief-item">
                            <span class="brief-label">Mã đơn hàng</span>
                            <strong class="brief-value highlight">@(selectedOrder.Ordercode ?? ("DH-" + selectedOrder.Orderid))</strong>
                        </div>
                        <div class="brief-item">
                            <span class="brief-label">Nhà thuốc / Khách hàng</span>
                            <strong class="brief-value">@selectedOrder.Customername</strong>
                        </div>
                        <div class="brief-item">
                            <span class="brief-label">Số điện thoại</span>
                            <strong class="brief-value">@(string.IsNullOrWhiteSpace(selectedOrder.Customerphone) ? "—" : selectedOrder.Customerphone)</strong>
                        </div>
                        <div class="brief-item">
                            <span class="brief-label">Trạng thái đơn</span>
                            @if (isOrderCancelled)
                            {
                                <strong class="brief-value" style="color: #DC2626;">✕ Đã hủy (Cancelled)</strong>
                            }
                            else if (isOrderCompleted)
                            {
                                <strong class="brief-value" style="color: #166534;">✓ Đã xong (Completed)</strong>
                            }
                            else
                            {
                                <strong class="brief-value" style="color: #B45309;">Đang xử lý</strong>
                            }
                        </div>
                        <div class="brief-item full-row">
                            <span class="brief-label">Địa chỉ nhận hàng</span>
                            <p class="brief-address">@(string.IsNullOrWhiteSpace(selectedOrder.Shippingaddress) ? "Nhận trực tiếp tại kho trung tâm" : selectedOrder.Shippingaddress)</p>
                        </div>
                    </div>

                    <!-- BẢNG DANH MỤC THUỐC CỦA ĐƠN -->
                    <div class="co-table-wrapper">
                        <table class="co-clean-table">
                            <thead>
                                <tr>
                                    <th style="width: 40px; text-align: center;">STT</th>
                                    <th>Tên thuốc thành phẩm</th>
                                    <th style="width: 70px; text-align: center;">ĐVT</th>
                                    <th style="width: 80px; text-align: center;">SL Đặt</th>
                                    <th style="width: 80px; text-align: center;">Tồn kho</th>
                                    <th style="width: 100px; text-align: center;">Tình trạng</th>
                                    <th style="width: 110px; text-align: right;">Đơn giá</th>
                                    <th style="width: 120px; text-align: right;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int stt = 1;
                                    int totalQuantity = 0;
                                    var details = selectedOrder.SaleOrderDetails?.ToList() ?? new List<httt.Models.SaleOrderDetail>();
                                }
                                @if (details.Any())
                                {
                                    @foreach (var item in details)
                                    {
                                        var inStock = item.Product?.Quantity ?? 0;
                                        var isLack = item.Quantity > inStock;
                                        totalQuantity += item.Quantity;

                                        <tr>
                                            <td style="text-align: center; color: var(--text-muted);">@(stt++)</td>
                                            <td>
                                                <strong class="med-name">@(item.Product?.Productname ?? $"Sản phẩm #{item.Productid}")</strong>
                                                <span class="med-code">SP-@item.Productid.ToString("D4")</span>
                                            </td>
                                            <td style="text-align: center;">@(item.Product?.Unit ?? "Hộp")</td>
                                            <td style="text-align: center;">
                                                <span class="qty-tag">@item.Quantity</span>
                                            </td>
                                            <td style="text-align: center; font-weight: 700;">@inStock</td>
                                            <td style="text-align: center;">
                                                @if (isOrderCancelled)
                                                {
                                                    <span style="font-size: 10px; font-weight: 700; color: #991B1B; background: #FEE2E2; padding: 2px 6px; border-radius: 4px;">Đơn đã hủy</span>
                                                }
                                                else if (isLack)
                                                {
                                                    <span class="stock-tag-danger">Thiếu @(item.Quantity - inStock)</span>
                                                }
                                                else
                                                {
                                                    <span class="stock-tag-ok">Đủ tồn kho</span>
                                                }
                                            </td>
                                            <td style="text-align: right;">@((item.Unitprice ?? 0).ToString("N0")) đ</td>
                                            <td style="text-align: right; font-weight: 700;">@(((item.Unitprice ?? 0) * item.Quantity).ToString("N0")) đ</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" style="text-align: center; padding: 20px; color: var(--text-muted);">Đơn hàng này chưa có sản phẩm.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" style="text-align: right; font-weight: 700;">Tổng số lượng xuất:</td>
                                    <td style="text-align: center; font-weight: 800; color: var(--primary);">@totalQuantity</td>
                                    <td colspan="3" style="text-align: right; font-weight: 700;">Tổng giá trị đơn hàng:</td>
                                    <td style="text-align: right; font-weight: 800; color: var(--text-title);">
                                        @((selectedOrder.Totalamount ?? 0).ToString("N0")) đ
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- MỤC YÊU CẦU XUẤT HÀNG -->
                    <div class="co-dispatch-bar">
                        <div class="dispatch-info">
                            @if (isOrderCancelled)
                            {
                                <span style="color: #DC2626; font-weight: 600;">Đơn hàng đã bị hủy bỏ, các chức năng xuất kho đã đóng.</span>
                            }
                            else
                            {
                                <span>Lệnh xuất gửi trực tiếp đến thủ kho để chuẩn bị hàng và bàn giao.</span>
                            }
                        </div>
                        <div class="dispatch-actions" style="display: flex; align-items: center; gap: 8px;">
                            @if (isOrderCancelled)
                            {
                                <button type="button" class="btn-dispatch-now disabled" title="Không thể tạo phiếu cho đơn đã hủy" style="background: #E2E8F0; color: #94A3B8; cursor: not-allowed;">
                                    ✕ Đơn đã bị hủy
                                </button>
                            }
                            else if (isOrderCompleted)
                            {
                                <span class="pill-completed">
                                    ✓ Đã xong (Completed)
                                </span>
                            }
                            else if (isWarehouseDone)
                            {
                                <button type="button" class="btn-confirm-done" onclick="confirmCompleteOrder(@selectedOrder.Orderid, this)">
                                    ✔ Duyệt đơn ĐÃ XONG
                                </button>
                            }
                            else if (!isSent)
                            {
                                <button type="button" class="btn-dispatch-now" onclick="submitExportSlip(@selectedOrder.Orderid, this)">
                                    @(isLatestRejected ? "Tạo lại phiếu xuất kho" : "Yêu cầu xuất kho")
                                </button>
                                <span class="badge-waiting">@(isLatestRejected ? "Đã bị từ chối" : "Chờ lập phiếu")</span>
                            }
                            else
                            {
                                <button type="button" class="btn-dispatch-now disabled">
                                    Yêu cầu xuất kho
                                </button>
                                <span class="badge-waiting active">Chờ duyệt</span>
                                <button type="button" class="btn-clean-outline" onclick="resetReceiptForTest(@selectedOrder.Orderid)" title="Xóa phiếu đã lưu để kiểm tra lại">
                                    Xóa để test lại
                                </button>
                            }
                        </div>
                    </div>
                }
            </section>

            <!-- DANH SÁCH CÁC ĐƠN ĐÃ YÊU CẦU XUẤT (VẪN HIỂN THỊ VÀ GẮN BADGE KHÔNG HIỆU LỰC KHI ĐƠN BỊ HỦY) -->
            <section class="co-clean-card">
                <div class="co-card-title-bar">
                    <div>
                        <h2>Danh sách phiếu đã yêu cầu xuất kho</h2>
                        <span class="co-subtitle">Lưu vết toàn bộ yêu cầu xuất kho thành phẩm</span>
                    </div>
                    <span class="order-count">@exportReceipts.Count phiếu</span>
                </div>

                <div class="co-table-wrapper">
                    <table class="co-clean-table">
                        <thead>
                            <tr>
                                <th style="width: 40px; text-align: center;">STT</th>
                                <th style="width: 140px;">Mã phiếu xuất</th>
                                <th style="width: 130px;">Mã đơn đặt hàng</th>
                                <th>Nhà thuốc / Khách hàng</th>
                                <th style="width: 140px; text-align: center;">Thời điểm gửi</th>
                                <th style="width: 90px; text-align: center;">Số loại thuốc</th>
                                <th style="width: 150px; text-align: center;">Trạng thái kho</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!exportReceipts.Any())
                            {
                                <tr>
                                    <td colspan="7" style="text-align: center; padding: 20px; color: var(--text-muted);">
                                        Chưa có phiếu xuất kho thành phẩm nào được gửi yêu cầu.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int idx = 1;
                                foreach (var receipt in exportReceipts)
                                {
                                    int orderKey = receipt.Orderid ?? 0;
                                    string linkedCode = orderKey > 0 && orderLookupFull.ContainsKey(orderKey) ? orderLookupFull[orderKey].Code : (orderLookup.ContainsKey(orderKey) ? orderLookup[orderKey].Code : $"DH-{orderKey}");
                                    string linkedCustomer = orderKey > 0 && orderLookupFull.ContainsKey(orderKey) ? orderLookupFull[orderKey].Customer : (orderLookup.ContainsKey(orderKey) ? orderLookup[orderKey].Customer : (receipt.SaleOrder?.Customername ?? "Khách hàng"));
                                    string parentOrderStatus = orderKey > 0 && orderLookupFull.ContainsKey(orderKey) ? orderLookupFull[orderKey].Status : (receipt.SaleOrder?.Status ?? "");

                                    // Kiểm tra xem đơn hàng gốc có bị hủy hoặc phiếu bị hủy không
                                    bool isParentCancelled = string.Equals(parentOrderStatus, "Cancelled", StringComparison.OrdinalIgnoreCase) ||
                                                             parentOrderStatus == "Đã hủy" ||
                                                             string.Equals(receipt.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) ||
                                                             receipt.Status == "Đã hủy";

                                    bool isReceiptDone = !isParentCancelled && (
                                        string.Equals(receipt.Status, "Completed", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(receipt.Status, "Exported", StringComparison.OrdinalIgnoreCase) ||
                                        string.Equals(receipt.Status, "Approved", StringComparison.OrdinalIgnoreCase) ||
                                        receipt.Status == "Tán thành" ||
                                        receipt.Status == "Đã xuất kho" || 
                                        receipt.Status == "Đã hoàn thành");

                                    bool isReceiptRejected = !isParentCancelled && (
                                        string.Equals(receipt.Status, "Rejected", StringComparison.OrdinalIgnoreCase) ||
                                        receipt.Status == "Từ chối");

                                    <tr>
                                        <td style="text-align: center; color: var(--text-muted);">@(idx++)</td>
                                        <td>
                                            <strong style="color: var(--primary);">@receipt.Expreceiptcode</strong>
                                        </td>
                                        <td>
                                            <a href="/Sales/CreateOrder?orderId=@receipt.Orderid" class="order-link">
                                                @linkedCode
                                            </a>
                                        </td>
                                        <td><strong>@linkedCustomer</strong></td>
                                        <td style="text-align: center; color: var(--text-secondary);">
                                            @(receipt.Createddate.HasValue ? receipt.Createddate.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                                        </td>
                                        <td style="text-align: center; font-weight: 700;">
                                            @(receipt.ProductExportReceiptDetails?.Count ?? 0) loại
                                        </td>
                                        <td style="text-align: center;">
                                            @if (isParentCancelled)
                                            {
                                                <span class="pill-rejected" style="background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA; white-space: nowrap; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 4px;">
                                                    ✕ Không hiệu lực (Đơn hủy)
                                                </span>
                                            }
                                            else if (isReceiptDone)
                                            {
                                                <span class="pill-completed">Đã xuất kho</span>
                                            }
                                            else if (isReceiptRejected)
                                            {
                                                <span class="pill-rejected">✕ Bị từ chối</span>
                                            }
                                            else
                                            {
                                                <span class="pill-waiting">Chờ xuất kho</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <footer class="order-page-footer">
                <strong>PharmaMRP</strong>
                <span>Hệ thống quản lý kho thuốc và bán hàng</span>
            </footer>
        </main>
    </div>
</div>

<!-- MODAL CHỌN ĐƠN HÀNG NHANH -->
<div id="orderListModal" class="co-modal" style="display: none;">
    <div class="co-modal-overlay" onclick="closeOrderModal()"></div>
    <div class="co-modal-dialog">
        <div class="co-modal-header">
            <h3>Chọn mã đơn hàng cần xuất</h3>
            <button type="button" class="btn-close-modal" onclick="closeOrderModal()">✕</button>
        </div>
        <div class="co-modal-body">
            <input type="text" id="modalSearchInput" class="form-control" placeholder="Tìm theo mã đơn hoặc tên nhà thuốc..." onkeyup="filterModalOrders()" style="margin-bottom: 10px; height: 32px; font-size: 11.5px;" />
            
            <div class="modal-orders-list" id="modalOrderContainer">
                @foreach (var ord in ordersList)
                {
                    bool ordDone = string.Equals(ord.Status, "Completed", StringComparison.OrdinalIgnoreCase) || ord.Status == "Đã xong";
                    <div class="modal-order-card-item" data-code="@(ord.Ordercode ?? "")" data-cust="@(ord.Customername ?? "")" onclick="selectOrderModalItem(@ord.Orderid)">
                        <div class="m-card-top">
                            <strong style="color: var(--primary); font-size: 12px;">@(ord.Ordercode ?? ("DH-" + ord.Orderid))</strong>
                            <span class="@(ordDone ? "pill-completed" : "pill-waiting")" style="font-size: 9.5px; padding: 1px 5px;">
                                @(ordDone ? "Đã xong" : "Chờ xuất kho")
                            </span>
                        </div>
                        <div class="m-card-mid">@ord.Customername</div>
                        <div class="m-card-bottom">
                            <span>@(ord.Orderdate.HasValue ? ord.Orderdate.Value.ToString("dd/MM/yyyy HH:mm") : "")</span>
                            <strong>@((ord.Totalamount ?? 0).ToString("N0")) đ</strong>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function applySelectedOrder() {
            const dropdown = document.getElementById('selectOrderDropdown');
            if (dropdown && dropdown.value) {
                window.location.href = '/Sales/CreateOrder?orderId=' + dropdown.value;
            }
        }

        function openOrderModal() {
            document.getElementById('orderListModal').style.display = 'block';
        }

        function closeOrderModal() {
            document.getElementById('orderListModal').style.display = 'none';
        }

        function selectOrderModalItem(orderId) {
            window.location.href = '/Sales/CreateOrder?orderId=' + orderId;
        }

        function filterModalOrders() {
            const query = document.getElementById('modalSearchInput').value.toLowerCase().trim();
            const cards = document.querySelectorAll('.modal-order-card-item');
            cards.forEach(card => {
                const code = card.getAttribute('data-code').toLowerCase();
                const cust = card.getAttribute('data-cust').toLowerCase();
                card.style.display = (code.includes(query) || cust.includes(query)) ? 'block' : 'none';
            });
        }

        async function submitExportSlip(orderId, btn) {
            if (!confirm('Xác nhận gửi yêu cầu xuất kho sang bộ phận Kho?')) return;

            if (btn) {
                btn.style.pointerEvents = 'none';
                btn.innerHTML = 'Đang gửi...';
            }

            try {
                const res = await fetch('/Sales/CreateOrder/RequestExportSlip?orderId=' + orderId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await res.json();
                if (data.success) {
                    alert('✓ ' + data.message);
                    window.location.reload();
                } else {
                    alert('✕ ' + data.message);
                    if (btn) {
                        btn.style.pointerEvents = 'auto';
                        btn.innerHTML = 'Yêu cầu xuất kho';
                    }
                }
            } catch (err) {
                alert('✕ Lỗi: ' + err.message);
                if (btn) {
                    btn.style.pointerEvents = 'auto';
                    btn.innerHTML = 'Yêu cầu xuất kho';
                }
            }
        }

        async function confirmCompleteOrder(orderId, btn) {
            if (!confirm('Xác nhận duyệt hoàn tất đơn hàng và chuyển trạng thái sang ĐÃ XONG (Completed)?')) return;

            if (btn) {
                btn.style.pointerEvents = 'none';
                btn.innerHTML = 'Đang duyệt...';
            }

            try {
                const res = await fetch('/Sales/CreateOrder/CompleteOrderFromSlip?orderId=' + orderId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await res.json();
                if (data.success) {
                    alert('✓ ' + data.message);
                    window.location.reload();
                } else {
                    alert('✕ ' + data.message);
                    if (btn) {
                        btn.style.pointerEvents = 'auto';
                        btn.innerHTML = '✔ Duyệt đơn ĐÃ XONG';
                    }
                }
            } catch (err) {
                alert('✕ Lỗi: ' + err.message);
                if (btn) {
                    btn.style.pointerEvents = 'auto';
                    btn.innerHTML = '✔ Duyệt đơn ĐÃ XONG';
                }
            }
        }

        async function resetReceiptForTest(orderId) {
            if (!confirm('Xóa phiếu xuất của đơn này để kiểm tra lại nút Yêu cầu xuất kho?')) return;
            try {
                const res = await fetch('/Sales/CreateOrder/ClearReceiptForTest?orderId=' + orderId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('✕ Lỗi: ' + data.message);
                }
            } catch (err) {
                alert('✕ Lỗi: ' + err.message);
            }
        }
    </script>
}