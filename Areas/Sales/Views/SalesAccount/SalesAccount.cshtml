
@{
    ViewData["Title"] = "Tài khoản bán hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/sales-account.css"
          asp-append-version="true" />
}

<div class="sales-account">
    <div class="sales-workspace">

        <!-- SIDEBAR -->
        <aside class="sales-sidebar">
            <div class="sales-sidebar-brand">
                <div class="sales-brand-icon">✚</div>
                <div>
                    <h2>PharmaMRP</h2>
                    <span>HỆ THỐNG BÁN HÀNG</span>
                </div>
            </div>

            <div class="sales-sidebar-label">MENU BÁN HÀNG</div>

            <nav class="sales-sidebar-nav">

                <a class="sales-nav-item"
                   href="/Sales/Orders">
                    <span class="sales-nav-icon">▤</span>
                    <span>Xem đơn hàng</span>
                </a>

                <!-- CHỨC NĂNG MỚI: TẠO ĐƠN HÀNG -->
                <a class="sales-nav-item"
                   href="/Sales/CreateOrder">
                    <span class="sales-nav-icon">＋</span>
                    <span>Tạo đơn hàng thành phẩm</span>
                </a>

                <a class="sales-nav-item"
                   href="/Sales/TransactionHistory">
                    <span class="sales-nav-icon">◷</span>
                    <span>Lịch sử đơn hàng nhập xuất</span>
                </a>

                <a class="sales-nav-item"
                   href="/Sales/ExportSlips">
                    <span class="sales-nav-icon">⇧</span>
                    <span>Theo dõi phiếu xuất kho</span>
                </a>

                <a class="sales-nav-item"
                   href="/Sales/MedicineInventory">
                    <span class="sales-nav-icon">▦</span>
                    <span>Tra cứu thuốc và tồn kho</span>
                </a>

                <a class="sales-nav-item active"
                   href="/Sales/SalesAccount">
                    <span class="sales-nav-icon">♙</span>
                    <span>Tài khoản của tôi</span>
                    <span class="sales-nav-arrow">›</span>
                </a>

                <a class="sales-nav-item"
                   href="/Sales/RevenueReport">
                    <span class="sales-nav-icon">▥</span>
                    <span>Thống kê, báo cáo doanh thu</span>
                </a>

            </nav>

            <div class="sales-sidebar-bottom">
                <div class="sales-sidebar-user-avatar">NV</div>
                <div class="sales-sidebar-user-info">
                    <strong>Nhân viên bán hàng</strong>
                    <span>sales_user</span>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="sales-main-content">

            <div class="sales-page-heading">
                <div>
                    <div class="sales-breadcrumb">
                        <span>Trang chủ</span>
                        <span class="breadcrumb-separator">/</span>
                        <span>Bán hàng</span>
                        <span class="breadcrumb-separator">/</span>
                        <strong>Tài khoản</strong>
                    </div>

                    <h1>Tài khoản của tôi</h1>
                    <p>Quản lý thông tin cá nhân và tài khoản nhân viên.</p>
                </div>

                <div class="sales-heading-icon">👤</div>
            </div>

            <!-- PROFILE BANNER -->
            <section class="sales-profile-banner">
                <div class="sales-profile-main">
                    <div class="sales-avatar">NV</div>

                    <div class="sales-profile-text">
                        <span class="sales-eyebrow">HỒ SƠ NHÂN VIÊN</span>
                        <h2>Nhân viên bán hàng</h2>
                        <p>
                            <span class="sales-profile-dot"></span>
                            sales_user
                        </p>
                    </div>
                </div>

                <div class="sales-profile-badges">
                    <span class="sales-role-badge">
                        <span>✦</span> Nhân viên Sales
                    </span>

                    <span class="sales-status-badge">
                        <span class="status-dot"></span>
                        Đang hoạt động
                    </span>
                </div>
            </section>

            <!-- SUMMARY -->
            <div class="sales-section-title">
                <div>
                    <h3>Tổng quan tài khoản</h3>
                    <p>Thông tin cơ bản về tài khoản của bạn</p>
                </div>
            </div>

            <div class="sales-summary-grid">
                <div class="sales-summary-card">
                    <div class="summary-icon icon-blue">♙</div>
                    <div>
                        <span class="summary-label">Tài khoản</span>
                        <strong>sales_user</strong>
                        <small>Tên đăng nhập</small>
                    </div>
                </div>

                <div class="sales-summary-card">
                    <div class="summary-icon icon-green">✓</div>
                    <div>
                        <span class="summary-label">Trạng thái</span>
                        <strong class="summary-active">Hoạt động</strong>
                        <small>Tài khoản đang sử dụng</small>
                    </div>
                </div>

                <div class="sales-summary-card">
                    <div class="summary-icon icon-purple">▤</div>
                    <div>
                        <span class="summary-label">Phân quyền</span>
                        <strong>Sales</strong>
                        <small>Nhân viên bán hàng</small>
                    </div>
                </div>
            </div>

            <!-- ACCOUNT INFORMATION -->
            <section class="sales-info-card">
                <div class="sales-info-heading">
                    <div class="sales-info-heading-icon">▤</div>
                    <div>
                        <h3>Thông tin cá nhân</h3>
                        <p>Thông tin được sử dụng trong hệ thống PharmaMRP</p>
                    </div>
                </div>

                <div class="sales-info-grid">
                    <div class="sales-info-field">
                        <label>Tên đăng nhập</label>
                        <div class="sales-input-wrap">
                            <span class="field-icon">♙</span>
                            <input type="text"
                                   value="sales_user"
                                   readonly />
                        </div>
                    </div>

                    <div class="sales-info-field">
                        <label>Họ và tên</label>
                        <div class="sales-input-wrap">
                            <span class="field-icon">♧</span>
                            <input type="text"
                                   value="Nhân viên bán hàng"
                                   readonly />
                        </div>
                    </div>

                    <div class="sales-info-field">
                        <label>Vai trò hệ thống</label>
                        <div class="sales-input-wrap">
                            <span class="field-icon">▣</span>
                            <input type="text"
                                   value="Sales"
                                   readonly />
                        </div>
                    </div>

                    <div class="sales-info-field">
                        <label>Trạng thái tài khoản</label>
                        <div class="sales-input-wrap">
                            <span class="field-icon field-icon-green">●</span>
                            <input type="text"
                                   value="Đang hoạt động"
                                   readonly />
                        </div>
                    </div>
                </div>

                <div class="sales-info-footer">
                    <span class="sales-info-footer-icon">ⓘ</span>
                    <p>
                        Đây là thông tin minh họa cho giao diện.
                        Dữ liệu chưa được kết nối với tài khoản nhân viên thực tế.
                    </p>
                </div>
            </section>

            <div class="sales-page-footer">
                <span>PharmaMRP</span>
                <span>Hệ thống quản lý kho và bán hàng dược phẩm</span>
            </div>

        </main>
    </div>
</div>
